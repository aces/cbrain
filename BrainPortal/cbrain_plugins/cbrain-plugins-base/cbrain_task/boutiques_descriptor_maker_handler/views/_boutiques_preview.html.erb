<div class="preview-div">
  <p>
      <input class="ui-button ui-widget ui-state-default ui-corner-all" id="check"
              type="submit" value="<%= t('descriptor_maker_controls.check') %>" style="float:left">
      (<label for='_bdm_reorder'><%= t('descriptor_maker_controls.reorder') %> </label><input id="_bdm_reorder" type="checkbox" name="cbrain_task[params][_bdm_reorder]">)
      (<label for='_bdm_pad'><%= t('descriptor_maker_controls.pad') %> </label><input id="_bdm_pad"     type="checkbox" name="cbrain_task[params][_bdm_pad]">)
