<% file_ids = params[:interface_userfile_ids] || [] %>
<strong><%= t('bash_scriptor_ui.files', count: file_ids.size) %></strong><BR>
<UL>
  <% file_ids[0,10].each do |id| %>
    <LI><%= link_to_userfile_if_accessible id %></LI>
  <% end %>
  <% if file_ids.size > 10 %>
    <LI><%= t('bash_scriptor_ui.more', count: file_ids.size - 10) %></LI>
  <% end %>
</UL>

<% if @task.new_record? %>

  <% if file_ids.size > 1 %>
    <p>
    <strong><%= t('bash_scriptor_ui.shared') %></strong>
    <%= form.params_check_box :share_all_wds %>
  <% end %>

<p>
<strong><%= t('bash_scriptor_ui.serialization') %></strong><br>
  <%= t('bash_scriptor_ui.partition_html', field: form.params_text_field(:num_files_per_task, :size => 4)) %>
<% end %>

<p>
<strong><%= t('bash_scriptor_ui.properties') %></strong><br>
<%= t('bash_scriptor_ui.owner') %>&nbsp;<%=   user_select  :saved_files_user_id.to_la,  { :selector => (params[:saved_files_user_id]  || @task.user_id) } %>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
<%= t('bash_scriptor_ui.project') %>&nbsp;<%= group_select :saved_files_group_id.to_la, { :selector => (params[:saved_files_group_id] || @task.group_id) } %>

<p>
<strong><%= t('bash_scriptor_ui.estimate_prompt') %></strong>
<%= form.params_select(:time_estimate_per_file,
      options_for_select( [
        [ t('bash_scriptor_ui.seconds', count: 10),    "10" ],
        [ t('bash_scriptor_ui.seconds', count: 30),    "30" ],
        [ t('bash_scriptor_ui.minutes', count: 1),      "60" ],
        [ t('bash_scriptor_ui.minutes', count: 2),    "120" ],
        [ t('bash_scriptor_ui.minutes', count: 3),    "180" ],
        [ t('bash_scriptor_ui.minutes', count: 5),    "300" ],
        [ t('bash_scriptor_ui.minutes', count: 10),   "600" ],
        [ t('bash_scriptor_ui.minutes', count: 15),   "900" ],
        [ t('bash_scriptor_ui.minutes', count: 30),  "1800" ],
        [ t('bash_scriptor_ui.hours', count: 1),      "3600" ],
        [ t('bash_scriptor_ui.hours', count: 2),     "7200" ],
        [ t('bash_scriptor_ui.hours', count: 4),    "14400" ]
      ], (params[:time_estimate_per_file] || "60")
      )
   )
%>

<P>

<strong><%= t('bash_scriptor_ui.script') %></strong><br>
<%= t('bash_scriptor_ui.run') %><br>
<%= form.params_text_area :bash_script, :rows => 40, :cols => 160 %><br>
<small><%= t('bash_scriptor_ui.editor') %></small>

<P>
<strong><%= t('bash_scriptor_ui.substitutions') %></strong><br>

<dl>

  <dt>{cbrain_userfile_id}</dt>
  <dd><%= t('bash_scriptor_ui.file_id') %></dd>

  <dt>{cbrain_userfile_name}</dt>
  <dd><%= t('bash_scriptor_ui.file_name') %></dd>

  <dt>{cbrain_userfile_cache_full_path}</dt>
  <dd><%= t('bash_scriptor_ui.cache_path') %></dd>

  <dt>{cbrain_task_cluster_workdir}</dt>
  <dd><%= t('bash_scriptor_ui.work_path') %></dd>

  <dt>{cbrain_task_id}</dt>
  <dd><%= t('bash_scriptor_ui.task_id') %></dd>

  <dt>{cbrain_task_run_number}</dt>
  <dd><%= t('bash_scriptor_ui.run_number') %></dd>

  <dt>{cbrain_task_run_id}</dt>
  <dd><%= t('bash_scriptor_ui.run_id') %></dd>

  <dt>{cbrain_cluster_name}</dt>
  <dd><%= t('bash_scriptor_ui.server') %></dd>

  <dt>{cbrain_userfile_list_size}</dt>
  <dd><%= t('bash_scriptor_ui.list_size_html') %></dd>

  <dt>{cbrain_userfile_list_counter}</dt>
  <dd><%= t('bash_scriptor_ui.counter_html') %></dd>

  <dt>{cbrain_touch_when_completed}</dt>
  <dd><%= t('bash_scriptor_ui.touch') %></dd>

</dl>

<P>
<strong><%= t('bash_scriptor_ui.output_pattern') %></strong><br>
<%= t('bash_scriptor_ui.stdout_html') %><br>

<pre class="script_preview">Please CBRAIN, save <span class="highlight_in_situ">some/relative/path</span> to <span class="highlight_in_situ">SomeUserfileType</span> named <span class="highlight_in_situ">some_userfile_name</span> [as child of <span class="highlight_in_situ">userfile_id</span>]</pre>

<%= t('bash_scriptor_ui.highlight_html') %>

<pre class="script_preview">Please CBRAIN, save <span class="highlight_in_situ">out/hello.report</span> to <span class="highlight_in_situ">LogFile</span> named <span class="highlight_in_situ">hello.log</span>
Please CBRAIN, save <span class="highlight_in_situ">out/hello.report</span> to <span class="highlight_in_situ">LogFile</span> named <span class="highlight_in_situ">hello.log</span> as child of <span class="highlight_in_situ">12345</span></pre>

