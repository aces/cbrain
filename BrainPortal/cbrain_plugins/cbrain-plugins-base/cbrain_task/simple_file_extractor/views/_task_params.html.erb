<fieldset>
  <legend><%= t('simple_file_extractor_ui.inputs') %></legend>
  <% file_ids = params[:interface_userfile_ids] || [] %>
  <strong><%= t('simple_file_extractor_ui.files', count: file_ids.size) %></strong><BR>
  <ul>
    <% file_ids[0,10].each do |id| %>
      <li><%= link_to_userfile_if_accessible id %></li>
    <% end %>
    <% if file_ids.size > 10 %>
      <li>(<%= t('simple_file_extractor_ui.more', count: file_ids.size - 10) %>)</li>
    <% end %>
  </ul>
</fieldset>

<fieldset>
  <legend><%= t('simple_file_extractor_ui.patterns') %></legend>
  <% 10.times do |i| %>
    <%= form.params_text_field "patterns[#{i}]", :size => 120 %><p>
  <% end %>
  <p>
  <strong><%= t('simple_file_extractor_ui.about') %></strong>
  <%= show_hide_toggle t('simple_file_extractor_ui.toggle'), "#pat-notes", :class  => 'action_link' %>
  <br>
  <div id="pat-notes" style="display: none">
    <%= t('simple_file_extractor_ui.intro_html') %>
    <p>
    <dl>
      <dt>*</dt>
      <dd>
        <%= t('simple_file_extractor_ui.asterisk') %>
      </dd>
      <dt>?</dt>
      <dd>
        <%= t('simple_file_extractor_ui.question') %>
      </dd>
    </dl>
    <p>
    <%= t('simple_file_extractor_ui.prefix_html') %>
    <p>
    <%= t('simple_file_extractor_ui.help') %>
  </div>
</fieldset>

<fieldset>
  <legend><%= t('simple_file_extractor_ui.output') %></legend>
  <%= form.params_text_field :output_file_name, :size => 40 %>
</fieldset>

