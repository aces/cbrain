<% title t('.title') %>

<h2><%= t('.headings.before_message_html') %></h2>

<h5><%= t('.headings.explanations') %></h5>

<%= t('.paragraphs.explanations_html') %>

<h5><%= t('.headings.allowed_providers') %></h5>

<ul>
  <% @allowed_prov_names.each do |provname| %>
    <% provname = t('.any_provider') if provname == '*' %>
    <li><%= provname %></li>
  <% end %>
</ul>


<% if @oidc_configs.empty? %>
  <%= t('.paragraphs.no_provider_html') %>
<% end %>

<% @oidc_configs.each do |oidc| %>
  <%= link_to t('.links.login_with', name: oidc.name), @oidc_uris[oidc.name], :class => 'button globus_button' %></br></br>
<% end %>

<% if !@oidc_configs.empty? %>
<%= t('.paragraphs.already_logged_in_html') %>
<% end %>

<% @oidc_configs.each do |oidc| %>
  <%= link_to t('.links.logout_from', name: oidc.name), oidc.logout_uri, :class => 'button globus_button' %></br></br>
<% end %>

