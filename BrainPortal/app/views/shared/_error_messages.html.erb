<% if object.errors.any? %>
  <%
    object_name    ||= object.class.model_name.human.downcase
    header_message ||= t('.header_message', count: object.errors.count, object_name: object_name)
    message        ||= t('.message')
    html_options   ||= {}
  %>
  <div id="errorExplanation" class="errorExplanation" <%= html_options.to_html_attributes.html_safe %>>
    <h2><%= header_message %></h2>
    <p><%= message %></p>
    <ul>
    <% object.errors.full_messages.each do |msg| %>
      <li><%= msg %></li>
    <% end %>
    </ul>
  </div>
<% end %>

