<% title t('.title') %>

<em>
<%= t('.note_html')%>
</em>
<p>

<%= build_tabs( :class => 'available_tabs' ) do |tb| %>
  <%= tb.tab(t('activerecord.models.tool.other')) do %>
    <%= render :partial => 'available_tools_table',    :locals => { :tools  => @open_tools,       :category => :open       } %>
    <%= render :partial => 'available_tools_table',    :locals => { :tools  => @restricted_tools, :category => :restricted } %>
  <% end %>

  <%= tb.tab(t('dataset.other')) do %>
    <%= render :partial => 'available_datasets_table', :locals => { :groups => @public_groups,    :category => :open       } %>
    <%= render :partial => 'available_datasets_table', :locals => { :groups => @private_groups,   :category => :restricted } %>
  <% end %>
<% end %>
