<div class="menu_bar">
  <% if current_user.has_role?(:site_manager) || current_user.has_role?(:admin_user) %>
    <%= link_to t('.links.leave_message'), new_message_path, :class => "button" %>
  <% end %>
  <%= overlay_ajax_link t('help'), "/doc/#{I18n.locale}/messages/message_info.html", :class  => "button" %>

  <%= external_submit_button t('.buttons.delete_checked'), "message_form", :class  => "button", :confirm  => t('confirm_delete', name: t('.buttons.delete_name'))  %>
</div>

<%=
  render(:partial => 'shared/active_filters', :locals  => {
    :scope => @scope,
    :model => Message
  })
%>

<%# TODO this interface is not as good as it should be... %>
<div class="pagination">
  <span class="pagination_center">
    (
      <%= t('messages.common.message_count', count: @messages.total_entries) %>
      <% if @unread_count > 0 %>,
        <%=
          scope_filter_link(
            html_colorize(t('.scopes.unread_link', count: @unread_count)),
            @scope, :set, { :a => 'read', :v => 0 },
            link: { :ajax => true }
          )
        %>
      <% end %>
      <% if @read_count > 0 %>,
        <%=
          scope_filter_link(
            t('.scopes.read_link', count: @read_count),
            @scope, :set, { :a => 'read', :v => 1 },
            link: { :ajax => true }
          )
        %>
      <% end %>
    )
  </span>
</div>

<%= form_tag({ :controller => :messages, :action => :delete_messages }, :method => :delete, :id => "message_form") do %>
  <%=
    dynamic_scoped_table(@messages,
      :id         => "message_table",
      :class      => [ :resource_list ],
      :scope      => @scope,
      :order_map  => {
        :sender    => { :a => 'users.login', :j => [User, 'id', 'sender_id'] },
        :recipient => { :a => 'users.login', :j => [User, 'id', 'user_id']   }
      },
      :filter_map => {
        :sender    => { :a => 'sender_id' },
        :recipient => { :a => 'user_id'   },
        :last_sent => { :a => 'last_sent', :o => '<=' }
      }
    ) do |t|
  %>
    <%
      t.paginate
      t.selectable("message_ids[]")

      t.row do |m| {
        :class => [
          "message_display_#{m.id}",
          "#{m.message_type}_display",
          "message_#{m.read? ? "" : "un"}read"
        ]
      } end
    %>

    <%
      # Unicode character 'WARNING SIGN' (U+26A0)
      t.column("&#9888;".html_safe, :critical,
        :pretty_name => t('.columns.criticality.critical'),
        :hidden      => true,
        :filters     => scoped_filters_for(
          @base_scope, @scope, :critical,
          format: lambda do |format_info|
            value, label, base, view = *format_info
            label = (! value || value == 0) ? t('.columns.criticality.not_critical') : t('.columns.criticality.critical')
            {
              :value     => value,
              :label     => t('.labels.base', label: label, base: base),
              :indicator => view,
              :empty     => view == 0
            }
          end
        )
      ) { |m| html_colorize("!!!") if m.critical }

      t.column(t('.columns.type'), :message_type,
        :hidden   => true,
        :sortable => true,
        :filters  => scoped_filters_for(
          @base_scope, @scope, :message_type,
          format: lambda do |format_info|
            value, label, base, view = *format_info
            {
              :value     => value,
              :label     => t('.labels.base', label: label.humanize, base: base),
              :indicator => view,
              :empty     => view == 0
            }
          end
        )
      ) { |m| m.message_type.humanize }
    %>

    <% t.column(t('.columns.message'), :header, :sortable => true) do |m| %>
      <%= show_hide_toggle(Message.parse_markup(m.header), "#message_table_details_#{m.id}") %>
      <div id="message_table_details_<%= m.id %>" style="display: none">
        <%= render :partial  => 'messages/message_details', :locals  => { :mess  => m } %>
      </div>
    <% end %>

    <%
      t.column(t('.columns.sender'), :sender,
        :sortable => true,
        :filters  => filter_values_for(
          @base_scope, :sender_id,
          label: 'users.login',
          association: [User, 'id', 'sender_id']
        ) + [{
          :value     => nil,
          :label     => t('messages.common.labels.system'),
          :indicator => @view_scope
            .where('sender_id' => nil)
            .count
        }]
      ) { |m| m.sender.try(:login) || t('messages.common.labels.system') }

      t.column(t('.columns.recipient'), :recipient,
        :sortable => true,
        :filters  => scoped_filters_for(
          @base_scope, @scope, :user_id,
          label: 'users.login',
          association: [User, 'id', 'user_id']
        )
      ) { |m| link_to_user_with_tooltip(m.user) } unless
        current_user.has_role?(:normal_user)

      t.column(t('.columns.last_updated'), :last_sent,
        :sortable => true,
        :filters  => ([
          [10.minutes, t('messages.common.time_ago.ten_minutes')],
          [1.hour,     t('messages.common.time_ago.one_hour')   ],
          [1.day,      t('messages.common.time_ago.one_day')    ],
          [2.days,     t('messages.common.time_ago.two_days')   ],
          [1.week,     t('messages.common.time_ago.one_week')   ],
          [1.month,    t('messages.common.time_ago.one_month')  ],
          [2.months,   t('messages.common.time_ago.two_months') ],
          [1.year,     t('messages.common.time_ago.one_year')   ]
        ]).map do |value, label|
          [value.ago.to_datetime, label + ' ago']
        end
      ) { |m| to_localtime(m.last_sent, :datetime) }
    %>

    <% t.column(t('.columns.operations'), :operations) do |m| %>
      <div>
        <%=
          click_state   = m.read ? t('messages.common.labels.state_unread') : t('messages.common.labels.state_read') # inverse of current state
          delete_button("<span class=\"read_unread\">#{t('messages.common.mark_as_html', state: click_state)}</span>".html_safe,
            message_path(m, :read => (!m.read).to_s),
            :class                  => 'action_link',
            :method                 => "PUT",
            :target                 => ".message_display_#{m.id}",
            :loading_message        => "<span style='color: red; text-align: center;'>#{t('messages.common.deleting')}</span>",
            :loading_message_target => ".message_display_#{m.id} > td.operations > div > a > span.read_unread"
          )
        %>
        &nbsp;
        <%=
          delete_button("<span class=\"del_label\">#{t('delete')}</span>".html_safe,
            message_path(m),
            :class                  => 'action_link',
            :method                 => "DELETE",
            :target                 => ".message_display_#{m.id}",
            :remove_target          => ".message_display_#{m.id}",
            :loading_message        => "<span style='color: red; text-align: center;'>#{t('messages.common.deleting')}</span>",
            :loading_message_target => ".message_display_#{m.id} > td.operations > a > span.del_label"
          )
        %>
      </div>
    <% end %>
  <% end %>
<% end %>

