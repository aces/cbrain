<% title t('.title') %>

<h2><%= t('.headings.main') %></h2>

<%= t('.paragraphs.generated_intro') %>
<p>
  <code class="copy-text"><%= @new_token %></code>
  <%= copy_to_clipboard_button(
     @new_token,
     label: t('.labels.copy'),
     title: t('.titles.copy_tooltip'))  %>
<p>

<%= t('.paragraphs.token_html') %>
<strong><%= t('.titles.notes') %></strong>:

<% pretty_how_long = SessionHelpers::SESSION_API_TOKEN_VALIDITY.inspect %>
<ul>
  <li>
    <%= t('.li.validity', duration: pretty_how_long) %>
  </li>
  <li>
    <%= t('.li.renewal', duration: pretty_how_long) %>
  </li>
  <li>
    <%= t('.li.ip_lock_html') %>
  </li>
  <li>
    <%= t('.li.ip_invalid_html') %>
  </li>
  <li>
    <%= t('.li.copy_html') %>
  </li>
</ul>
