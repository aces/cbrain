<div class="menu_bar">
  <% if current_user.has_role?(:admin_user) %>
    <%= link_to t('.links.create_new_tool'), new_tool_path, :class => "button menu_button" %>
    <%= link_to t('.links.autoload_tools'), { :action  => :create, :autoload  => true}, :method  => :post, :class => "button menu_button", :title => t('.titles.autoload_tools') %>
    <%= link_to t('.links.access_reports'), { :controller => :tool_configs, :action => :report }, :class => "button menu_button" %>
  <% end %>

  <%= link_to t('.links.tool_versions_list'), tool_configs_path, :class => "button menu_button" %>
  <%= overlay_ajax_link t('help'), "/doc/#{I18n.locale}/tool/tool_info.html", :class  => "button menu_button" %>
</div>

<%=
  render(:partial => 'shared/active_filters', :locals  => {
    :scope => @scope,
    :model => Tool
  })
%>

<%=
  dynamic_scoped_table(@tools,
    :id         => 'tools_table',
    :class      => [ :resource_list ],
    :scope      => @scope,
    :order_map  => {
      :owner => { :a => 'users.login', :j => User  },
      :group => { :a => 'groups.name', :j => Group }
    },
    :filter_map => {
      :owner => { :a => 'user_id'  },
      :group => { :a => 'group_id' }
    }
  ) do |t|
%>
  <%
    t.column(t('.columns.name'), :name,
      :sortable => true
    ) do |tool|
      if current_user.has_role?(:admin_user)
        link_to tool.name, { :action => :edit, :id => tool.id }
      else
        tool.name
      end
    end

    t.column(t('.columns.description'), :description,
      :sortable => true
    ) { |tool| overlay_description(tool.description) }

    t.column(t('.columns.category'), :category,
      :sortable => true,
      :filters  => default_filters_for(@base_scope, :category)
    )

    t.column(t('.columns.owner'), :owner,
      :sortable => true,
      :filters  => default_filters_for(@base_scope, User)
    ) { |tool| link_to_user_with_tooltip(tool.user) }

    t.column(t('.columns.group'), :group,
      :sortable => true,
      :filters  => default_filters_for(@base_scope, Group)
    ) { |tool| link_to_group_if_accessible(tool.group) }

    t.column(t('.columns.execution_versions'), :exec) do |tool|
      tool.bourreaux
        .reject { |b| ! b.can_be_accessed_by?(current_user) }
        .sort { |a,b| a.name.casecmp(b.name) }
        .map do |b|
          tcs = ToolConfig
            .where(:bourreau_id => b.id, :tool_id => tool.id)
            .reject { |tc| ! tc.can_be_accessed_by?(current_user) }
            .size
          tcs.zero? ? "" :
            link_to_bourreau_if_accessible(b) + " " +
            link_to(t('.links.version_count', count: tcs), :controller => :tool_configs, :action => :index, :bourreau_id => b.id, :tool_id => tool.id, :_simple_filters => 1 )
        end
        .join('<br>')
        .html_safe
    end

    if current_user.has_role?(:admin_user)
      t.column(t('.columns.access'), :access) do |tool|
        link_to t('.links.access'),
          {
            :controller => :tool_configs,
            :action     => :report,
            :tool_id    => tool.id
          },
          :class => "action_link"
      end
    end

    t.column(t('.columns.help'), :help) do |tool|
      path   = tool.cbrain_task_class.public_path("edit_params_help.html") rescue nil
      path ||= tool.cbrain_task_class.help_filepath rescue nil # Boutiques help-page
      overlay_ajax_link t('help'), path.to_s if path
    end

    t.column(t('.columns.info'), :info) do |tool|
      path = tool.cbrain_task_class.public_path("tool_info.html") rescue nil
      overlay_ajax_link t('.columns.info'), path.to_s if path
    end
  %>

<% end %>
