<%= error_messages_for(@tool) %>

<%= show_table(@tool, :edit_condition => true, :header => t('.headings.general_info')) do |t| %>

  <% t.edit_cell :name, :header => t('.headings.name') do |f|%>
    <%= f.text_field :name %>
  <% end %>

  <% t.cell(t('.cells.created'))      { @tool.created_at.present? ? to_localtime(@tool.created_at,:datetime) : "" } %>

  <% t.edit_cell :cbrain_task_class_name, :header => t('.headings.cbrain_task_class_name'),
                      :td_options => {:title => t('.titles.cbrain_task_class_name')} do |f| %>
    <%= f.text_field :cbrain_task_class_name, :size => 30 %>
  <% end %>

  <% t.cell(t('.cells.last_updated')) { @tool.updated_at.present? ? to_localtime(@tool.updated_at,:datetime) : "" } %>

  <% t.edit_cell :user_id, :show_width => 2, :content => link_to_user_with_tooltip(@tool.user), :header => t('.headings.belongs_to') do |f| %>
    <%= user_select "tool[user_id]", @tool.user, :id => 'tool_user_id' %>
  <% end %>

  <% t.edit_cell :group_id, :show_width => 2, :content => link_to_group_if_accessible(@tool.group), :header => t('.headings.available_to_project') do |f| %>
    <%= group_select "tool[group_id]", @tool.group, :id => 'tool_group_id' %>
  <% end %>

  <% t.edit_cell :category, :header => t('.headings.category') do |f| %>
     <%= f.select :category, Tool::Categories %>
  <% end %>

  <% joint_licenses = @tool.license_agreements.join("\n") %>

  <% licenses = @tool.license_agreements.count == 0 ? t('none') : joint_licenses %>
  <% t.edit_cell :license_agreements, :header => t('.headings.license_agreements'), :content => licenses do |f| %>
    <%= f.text_area :license_agreements, :value => @tool.new_record? ? "" : joint_licenses, :rows => 3, :cols => 30 %>
    <%= t('.paragraphs.license_agreements_html') %>
  <% end %>

  <% t.edit_cell :description, :show_width => 2, :header => t('.headings.description'), :content => full_description(@tool.description) do |f|%>
    <%= f.text_area :description, :cols => 80, :rows => 10 %>
    <%= t('.paragraphs.description_html') %>
  <% end %>

  <% t.edit_cell :application_package_name, :header => t('.headings.package_name') do |f| %>
    <%= f.text_field :application_package_name %>
  <% end %>

  <% t.edit_cell :application_type, :header => t('.headings.tool_type') do |f| %>
    <%= f.text_field :application_type %>
  <% end %>

  <% t.edit_cell :application_tags, :show_width => 2, :header => t('.headings.comma_separated_tags') do |f| %>
    <%= f.text_field :application_tags, :size => 60 %>
  <% end %>

  <% t.edit_cell :url, :show_width => 2, :header => t('.headings.url'), :content => (@tool.url.present? ? link_to(@tool.url,@tool.url) : "") do |f| %>
    <%= f.text_field :url, :size => 60 %>
  <% end %>

  <% "" # Not used anymore? %>
  <% false and t.edit_cell :select_menu_text, :header => t('.headings.select_menu_text') do |f| %>
    <%= f.text_field :select_menu_text, :size => 40 %>
  <% end %>

<% end %>

<% if @tool && !@tool.new_record? %>
<p>
  <%= t('.labels.common_config') %> <%= link_to t('edit'), new_tool_config_path( :tool_id => @tool.id ) %><br/>

<p>
  <%= t('.labels.versions_installed') %><br/>
  <table class="simple" width="100%">
    <% for bourreau in Bourreau.find_all_accessible_by_user(current_user).all %>
      <tr>
          <th colspan="6" class="centered">
            <%= link_to_bourreau_if_accessible(bourreau) %>
          </th>
      </tr>
      <% tcs = ToolConfig.where( :bourreau_id => bourreau.id, :tool_id => @tool.id ).all.to_a %>
      <% tcs << 'Dummy entry for "add new" row' %>
      <% rows = tcs.size %>
      <% tcs.each_with_index do |tc,i| %>
        <tr class="<%= cycle("list-odd", "list-even") %>">
          <% if i == rows - 1 %>
            <td colspan="6">
              <center>
              <% if rows <= 1 %>
                <%= html_colorize(t('.no_versions_configured')) %>
              <% else %>
                <%= t('.versions_configured', count: rows-1) %>
              <% end %>
              <%= link_to t('.links.add_new'), new_tool_config_path( :tool_id => @tool.id, :bourreau_id => bourreau.id ) %>
              </center>
            </td>
          <% else %>
            <td><%= overlay_description(tc.version_name + "\n" + tc.description) %></td>
            <td><%= link_to_group_if_accessible(tc.group) %></td>
            <td><%= t('.datas.cpu_count', count: (tc.ncpus || 1)) %></td>
            <td><%= link_to t('show'), tool_config_path(tc) %></td>
            <td><%= link_to t('delete'), tc, :data => { :confirm => t('confirm_delete', name: t('.version_config_name', name: tc.version_name)) }, :method => :delete %></td>
          <% end %>
        </tr>
      <% end %>
    <% end %>
  </table>
</p>
<% end %>
