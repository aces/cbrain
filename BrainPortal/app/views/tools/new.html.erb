<% title t('.title') %>

<h2><%= t('.headings.main') %></h2>

<%= error_messages_for @tool %>

<%= form_for @tool, :as => :tool, :url => { :action => "create" }, :datatype => "script" do |f| -%>

  <div class="generalbox">
      <p>
       <%= f.label :name, t('.labels.name') %>
       <%= f.text_field :name %>
      </p>

      <p>
        <span title="<%= t('.titles.cbrain_task_class') %>">
           <%= f.label :cbrain_task_class_name, t('.labels.cbrain_task_class') %>
           <%= f.text_field :cbrain_task_class_name %>
        </span>
      </p>

      <p>
       <%= f.label :user_id, t('.labels.belongs_to') %>
       <%= user_select "tool[user_id]", @tool, :id => 'tool_user_id' %>
      </p>

      <p>
       <%= f.label :group_id, t('.labels.group') %>
       <%= group_select "tool[group_id]", @tool, :id => 'tool_group_id' %>
      </p>

      <p>
        <%= f.label :category, t('.labels.category') %>
        <%= f.select :category, Tool::Categories %>
      </p>

      <p>
        <%= f.label :license_agreements, t('.labels.license_agreements') %><br>
        <%= f.text_area :license_agreements, :value => @tool.new_record? ? "" : @tool.license_agreements.join("\n") , :rows => 5, :cols => 40 %>
        <%= t('.paragraphs.license_agreements_html') %>
      </p>

      <p>
        <%= f.label :description, t('.labels.description') %><br>
        <%= f.text_area :description, :cols => 80, :rows => 10 %><br>
        <%= t('.paragraphs.description_html') %>
      </p>

      <p>
        <%= f.label :application_package_name, t('.labels.package_name') %><br>
        <%= f.text_field :application_package_name %><br>
      </p>

      <p>
        <%= f.label :application_type, t('.labels.tool_type') %><br>
        <%= f.text_field :application_type %><br>
      </p>

      <p>
        <%= f.label :application_tags, t('.labels.application_tags') %><br>
        <%= f.text_field :application_tags %><br>
      </p>

      <p>
        <%= f.label :url, t('.labels.url') %><br>
        <%= f.text_field :url %><br>
      </p>

      <p>
        <%= f.label :select_menu_text, t('.labels.select_menu_text') %>
        <%= f.text_field :select_menu_text %>
      </p>
  </div>

  <p><%= f.submit t('.submit') %></p>

<% end %>
