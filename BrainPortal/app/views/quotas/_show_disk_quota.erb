<% title @quota.new_record? ? t('.titles.create') : t('.titles.edit') %>

<%= error_messages_for @quota %>

<div class="menu_bar">

  <%= link_to t('.links.disk_quotas_table'), quotas_path(:mode => :disk), :class => :button %>

  <% if ! @quota.new_record? %>

    <% if @quota.is_for_user? %>
      <%= link_to t('.links.new_quota_same_user'),
          new_quota_path(:mode => :disk, :data_provider_id => -1                     , :user_id => @quota.user_id), :class => :button %>
    <% end %>

    <% if @quota.is_for_resource? %>
      <%= link_to t('.links.new_quota_same_provider'),
          new_quota_path(:mode => :disk, :data_provider_id => @quota.data_provider_id, :user_id => -1),             :class => :button %>
    <% end %>

  <% end %>

</div>



<%= show_table(@quota, :as => :quota, :header => t('.headings.record'),
                            :edit_condition => check_role(:admin_user)) do |t| %>
   <%= hidden_field_tag :mode, 'disk' %>

  <% t.cell(t('.columns.user')) do %>
      <% if @quota.new_record? %>
      <%= user_select("quota[user_id]", { :selector => @quota.user_id, :include_blank => t('.blanks.default_all_users') }) %>
    <% else %>
      <%= @quota.is_for_user? ?
          link_to_user_if_accessible(@quota.user) :
          html_colorize(t('.blanks.default_all_users'), 'orange') %>
    <% end %>
  <% end %>

  <% t.edit_cell(:max_bytes, :header => t('.headings.max_disk_space'), :content => pretty_quota_max_bytes(@quota)) do |f| %>
    <%= f.text_field :max_bytes, :size => 12 %>
    <div class="field_explanation">
      <%= t('.divs.max_bytes_html') %>
    </div>
  <% end %>

  <% t.cell(t('.columns.data_provider')) do %>
    <% if @quota.new_record? %>
      <%= data_provider_select("quota[data_provider_id]", { :selector => @quota.data_provider_id, :include_blank => t('.blanks.select_data_provider') }) %>
    <% else %>
      <%= link_to_data_provider_if_accessible(@quota.data_provider) %>
    <% end %>
  <% end %>

  <% t.edit_cell(:max_files, :header => t('.headings.max_num_files'), :content => pretty_quota_max_files(@quota)) do |f| %>
    <%= f.text_field :max_files, :size => 12 %>
    <div class="field_explanation">
      <%= t('.divs.max_files_html') %>
    </div>
  <% end %>

<% end %>


<P>
<%= render :partial => "layouts/log_report", :locals  => { :log  => @quota.getlog, :title => t('.titles.log') } %>

