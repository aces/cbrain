<% cap_mode = @mode == :disk ? t('.mode.disk') : t('.mode.cpu') %>
<% title t('.title', mode: cap_mode) %>

<div class="menu_bar">
  <% if @mode == :cpu %>
    <%= show_hide_toggle t('.about'), ".cpu_quota_explanations", :class => 'button', :slide_effect => true, :slide_duration => 'fast'  %>
  <% end %>
  <% if @mode == :disk %>
    <%= show_hide_toggle t('.about'), ".disk_quota_explanations", :class => 'button', :slide_effect => true, :slide_duration => 'fast'  %>
  <% end %>
  <% if current_user.has_role? :admin_user %>
      <%= link_to t('.links.exceeded_report', mode: cap_mode), report_quotas_path(:mode => @mode), :class => :button %>
      <%= link_to t('.links.new_entry', mode: cap_mode),       new_quota_path(:mode => @mode),              :class => :button %>
  <% end %>
  <% if @mode == :cpu %>
    <%= link_to t('.links.to_disk'),  quotas_path(:mode => :disk), :class => :button %>
  <% end %>
  <% if @mode == :disk %>
    <%= link_to t('.links.to_cpu'),  quotas_path(:mode => :cpu),   :class => :button %>
  <% end %>
</div>

<% if @mode == :disk %>
  <fieldset class="disk_quota_explanations" style="display: none">
    <legend><%= t('.legends.about_disk') %></legend>
    <%= t('.paragraphs.disk_quota_explanations_html') %>
  </fieldset>
<% end %>

<% if @mode == :cpu %>
  <fieldset class="cpu_quota_explanations" style="display: none">
    <legend><%= t('.legends.about_cpu') %></legend>
    <%= t('.paragraphs.cpu_quota_explanations_html') %>
  </fieldset>
<% end %>

<% if @mode == :disk %>
<div id="disk_quotas_table" class="index_block">
  <%= render :partial => 'disk_quotas_table' %>
</div>
<% end %>

<% if @mode == :cpu %>
<div id="cpu_quotas_table" class="index_block">
  <%= render :partial => 'cpu_quotas_table' %>
</div>
<% end %>
