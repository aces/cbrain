<% title t('.title') %>

<h2><%= t('.headings.main') %></h2>

<%= error_messages_for @site %>

<%= form_for @site, :as => :site, :url => { :action => "create" }, :datatype => "script" do |f| -%>

  <div class="generalbox">

      <div>
        <%= f.label :name %><br/>
        <%= f.text_field :name %>
        <P/>

        <span title="<%= t('.titles.brief_description_title') %>" >
          <%= f.label :description, t('.labels.description') %><br/>
          <%= f.text_area :description, :rows => 10, :cols => 40 %><br/>
          <%= t('.paragraphs.brief_description_html') %>
        </span>
        <P/>

      </div>

      <div class="button_div">
        <!-- Separation between active and locked users -->
        <%
        user_by_lock_status_hash = User.all.to_a.hashed_partition { |u| u.account_locked == false ? t('.lock_status.active') : t('.lock_status.locked')}
        active_users = user_by_lock_status_hash[t('.lock_status.active')] || []
        locked_users = user_by_lock_status_hash[t('.lock_status.locked')] || []
        %>

        <!-- Active Users -->
        <div style="margin:0px">

          <%= t('.lock_status.active') %>
          <br>
          <div id="active_users" class="button_inner_div">
            <table class="button_table" style="border:0px;">
              <tr>
                <td><%= t('.datas.login') %></td>
                <td><%= t('.datas.regular_user') %></td>
                <td><%= t('.datas.site_manager') %></td>
              </tr>
              <% for user in active_users.sort { |a,b| a.full_name.casecmp(b.full_name) } %>
                <tr>
                  <td class="left_align"><%= link_to_user_with_tooltip(user) -%></td>
                  <td class="left_align"><%= check_box_tag("site[user_ids][]", user.id) %></td>
                  <td class="left_align"><%= check_box_tag("site[manager_ids][]", user.id) %></td>
                </tr>
              <% end %>
            </table>
          </div>
        </div>

      </div>

      <!-- Projects -->
      <div class="button_div">
        <div style="margin:0px">
          <%= t('.buttons.groups') %>
          <br>
          <div id="projects" class="button_inner_div">
            <table class="button_table" style="border:0px;">
              <% for group in WorkGroup.all.sort { |a,b| a.name.casecmp(b.name) } %>
                <tr>
                  <td class="left_align"><%= group.name -%></td>
                  <td class="left_align"><%= check_box_tag("site[group_ids][]", group.id.to_s) %></td>
                </tr>
              <% end %>
            </table>
          </div>
        </div>
      </div>

      <%if !locked_users.empty? %>
      <div>
        <!-- Locked Users -->
        <br/>
            <%= t('.lock_status.locked') %>
            <%= show_hide_toggle t('show_parentheses'), "#locked_users", :class  => 'action_link', :alternate_text => t('.hide') %>
          <div id="locked_users" style="display:none" class="button_inner_div">
            <table class="button_table" style="border:0px;">
              <tr>
                <td><%= t('.datas.login') %></td>
                <td><%= t('.datas.regular_user') %></td>
                <td><%= t('.datas.site_manager') %></td>
              </tr>
              <% for user in locked_users.sort { |a,b| a.full_name.casecmp(b.full_name) } %>
                <tr>
                  <td class="left_align"><%= link_to_user_with_tooltip(user) -%></td>
                  <td class="left_align"><%= check_box_tag("site[user_ids][]", user.id) %></td>
                  <td class="left_align"><%= check_box_tag("site[manager_ids][]", user.id) %></td>
                </tr>
              <% end %>
            </table>
          </div>
      </div>

      <% end %>

      <div class="display_row">
        <P/>
        <%= f.submit t('.submit') %>
      </div>
<% end %>
