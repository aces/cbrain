<% title t('.title') %>

<div class="menu_bar">
  <%= overlay_ajax_link t('help'), "/doc/#{I18n.locale}/sites/site_info.html", :class  => "button" %>
  <%= link_to t('delete'), site_path(@site),  { :data => { :confirm => t('confirm_delete', name: @site.name )},  :method => :delete, :class => "button"} %>
</div>

<br>

<%= error_messages_for @site, :header_message => t('.headings.could_not_be_updated') %>
<div class="display_inline_block" style="min-width: 50%">

  <%= show_table(@site, :edit_condition => check_role(:admin_user)) do |t| %>
    <% t.edit_cell(:name) { |f| f.text_field :name } %>
    <% t.edit_cell(:description, content: full_description(@site.description)) do |f| %>
      <%= f.text_area :description, cols:40, rows: 10 %><br/>
      <%= t('.paragraphs.description_html') %>
    <% end %>
  <% end %>
  <%= show_table(@site, :header => t('.headings.resources')) do |t| %>
    <% t.cell(t('.cells.managers'), :show_width => 2) do %>
      <%= array_to_table(@site.managers.sort{|a, b| a.login.casecmp(b.login)}, :min_data => 6, :table_class => 'simple bordered') {|u,r,c| link_to_user_with_tooltip(u)} %>
    <% end %>
    <%
      t.blank_row
      t.cell(t('.cells.users'))            { index_count_filter @site.users.count,  :users,  {:site_id => @site.id} }
      t.cell(t('.cells.groups'))           { index_count_filter @site.groups.count, :groups, {:site_id => @site.id} }
      t.cell(t('.cells.userfiles'))        { @site.userfiles_find_all.count }
      t.cell(t('.cells.data_providers'))   { @site.data_providers_find_all.count }
      t.cell(t('.cells.remote_resources')) { @site.remote_resources_find_all.count }
    %>
  <% end %>

  <br>

  <table class="resource_list">
    <tr>
      <th>
        <%= t('.headings.users') %>
        <% if check_role(:admin_user) %>
          <%= overlay_content_link t('update_parentheses'), :style => "text-decoration: underline; font-size: 0.9em", :enclosing_element => "span", :height => 400 do %>
            <%= form_for(@site) do |f| %>
              <div class="display_cell">
                <label><%= t('.labels.users') %></label>
                <table class="button_table">
                  <tr>
                    <td><%= t('.datas.login') %></td>
                    <td><%= t('.datas.regular_user') %></td>
                    <td><%= t('.datas.site_manager') %></td>
                  </tr>
                  <% for user in User.all.sort { |a,b| a.full_name.casecmp(b.full_name) } %>
                    <tr>
                      <td class="left_align"><%= link_to_user_with_tooltip(user) -%></td>
                      <td class="left_align"><%= check_box_tag("site[user_ids][]", user.id, @site.users.include?(user)) %></td>
                      <td class="left_align"><%= check_box_tag("site[manager_ids][]", user.id, @site.managers.include?(user)) %></td>
                    </tr>
                  <% end %>
                </table>
              </div>

              <div class="display_row">
                <P>
                <%= f.submit t('.submits.update_users'), :name => :update_users %>
              </div>

            <% end %>
          <% end %>
        <% end %>
      </th>
      <th>
        <%= t('.headings.groups') %>
        <% if check_role(:admin_user) %>
          <%= overlay_content_link t('update_parentheses'), :style => "text-decoration: underline; font-size: 0.9em", :enclosing_element => "span", :height => 400 do %>
            <%= form_for(@site) do |f| %>
              <%= render :partial => 'shared/group_tables', :locals => {:model => @site} %><br>
              <%= f.submit t('.submits.update_projects'), :name => :update_groups %>
            <% end %>
          <% end %>
        <% end %>
      </th>
      <th><%= t('.headings.data_providers') %></th>
      <th><%= t('.headings.remote_resources') %></th>
    </tr>
    <tr>
      <td><%= array_to_table(@site.users.all.sort{|a, b| a.login.casecmp(b.login)}, :min_data => 2, :table_class => 'simple bordered') {|u,r,c| link_to_user_with_tooltip(u)} %></td>
      <td><%= array_to_table(@site.groups.all.sort{|a, b| a.name.casecmp(b.name)}, :min_data => 2, :table_class => 'simple bordered') {|g,r,c| link_to_group_if_accessible(g)} %></td>
      <td><%= array_to_table(@site.data_providers_find_all.sort{|a, b| a.name.casecmp(b.name)}, :min_data => 2, :table_class => 'simple bordered') {|d,r,c| link_to_data_provider_if_accessible(d)} %></td>
      <td><%= array_to_table(@site.remote_resources_find_all.sort{|a, b| a.name.casecmp(b.name)}, :min_data => 2, :table_class => 'simple bordered') {|b,r,c| link_to_bourreau_if_accessible(b)} %></td>
    </tr>
  </table>
</div>


  <P>
  <%= render :partial => "layouts/log_report", :locals  => { :log  => @site.getlog, :title => t('.titles.site_log') } %>


