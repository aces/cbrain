<% title @maintype =~ /Userfile/    ? t('.title.file_deltas')      :
         @maintype =~ /Cputime/     ? t('resource_usage.common.task_cpu_time')   :
         @maintype =~ /Walltime/    ? t('resource_usage.common.task_walltime')   :
         @maintype =~ /Space.*Task/ ? t('resource_usage.common.task_final_status') : "" %>

<div class="menu_bar">
  <% buttons =
     [ [ t('.buttons.userfile_disk_space'),            'SpaceResourceUsageForUserfile'      ],
       [ t('resource_usage.common.task_cpu_time'),     'CputimeResourceUsageForCbrainTask'  ],
       [ t('resource_usage.common.task_walltime'),     'WalltimeResourceUsageForCbrainTask' ],
       [ t('resource_usage.common.task_final_status'), 'SpaceResourceUsageForCbrainTask'    ],
     ]
  %>

  <% buttons.each do |pair|
       button_label, maintype = pair
  %>
    <%= link_to button_label,
        url_for(scope_filter_params(@scope, :set, {
          :attribute => 'type',
          :value     => maintype,
        })),
        :class => "button menu_button",
        :style => (@maintype == maintype ? "background-color: #ccc" : "")
    %>
  <% end %>
</div>

<p>

<fieldset>
  <legend><%= t('.legends.table_description') %></legend>
  <%= t('.paragraphs.description_intro_html') %>
  <p class="medium_paragraphs">
  <% if    @maintype == 'SpaceResourceUsageForUserfile'      %>
    <%= t('.paragraphs.description_space_userfile_html') %>
  <% elsif @maintype == 'CputimeResourceUsageForCbrainTask'  %>
    <%= t('.paragraphs.description_cputime_html') %>
  <% elsif @maintype == 'WalltimeResourceUsageForCbrainTask' %>
    <%= t('.paragraphs.description_walltime_html') %>
  <% elsif @maintype == 'SpaceResourceUsageForCbrainTask'    %>
    <%= t('.paragraphs.description_space_task_html') %>
  <% end %>
  <p class="medium_paragraphs">
  <%= t('.paragraphs.description_cached_html') %>
</fieldset>

<p>

<fieldset>
  <legend><%= t('.legends.usage_summary') %></legend>

  <%= t('.usage_record_count', count: @resource_usages.total_entries) %>:
  <%= pretty_resource_usage_value(@maintype.constantize.new(:value => @total_plus)) %>
  <%= pretty_resource_usage_value(@maintype.constantize.new(:value => @total_minus)) if @total_minus < 0 %>
  <% if @total_plus > 0 && @total_minus < 0 %>
    (<%= t('.total') %>: <%= pretty_resource_usage_value(@maintype.constantize.new(:value => @total)) %>)
  <% end %>
  <% if @resource_usages.total_entries > 1 %>
    (<%= t('.average') %>: <%= pretty_resource_usage_value(
                    @maintype.constantize.new(
                     :value => (@total.to_f / @resource_usages.total_entries.to_f)
                    )
                  ) %>)
  </p>
  <% end %>
</fieldset>

<p>

<fieldset>

  <legend>
    <%= t('.legends.additional_filtering') %>
    <%= show_hide_toggle t('show_hide_parentheses'), ".filtering", :class => 'task_help_link', :slide_effect => true, :slide_duration => 'fast'  %>
  </legend>


  <%
    is_hidden = true

    is_hidden = false if (params[:date_range] && params[:date_range][:date_attribute].present?)
    is_hidden = false if  params[:deleted_items].present?
    is_hidden = false if (params[:positive_file_delta].present? && @maintype =~ /Userfile/)
    is_hidden = false if (params[:negative_file_delta].present? && @maintype =~ /Userfile/)
  %>

  <div class="simple filtering <%= is_hidden ? "hidden" : "" %>">
    <%= form_tag({ :action  => :index }, :method => :get) do %>

      <div>
        <div class="display_cell">
          <%= date_range_panel(params[:date_range] || {}, "date_range", :date_attributes => {:created_at => t('.by_creation_date')}) %>
        </div>

        <div class="display_cell">
          <%= check_box_tag(:deleted_items, "1", params["deleted_items"]) %>
          <%= label_tag(:deleted_items, t('.labels.only_deleted_items')) %>

          <br>

          <% if @maintype =~ /Userfile/ %>
            <%= check_box_tag(:positive_file_delta, "1", params["positive_file_delta"]) %>
            <%= label_tag(:positive_file_delta, t('.labels.positive_size_delta')) %>

            <br>

            <%= check_box_tag(:negative_file_delta, "1", params["negative_file_delta"]) %>
            <%= label_tag(:negative_file_delta, t('.labels.negative_size_delta')) %>
          <% end %>

        </div>
      </div>

      <br>

      <%= submit_tag t('.submits.refresh_table'), :id => "refresh_data_table", :disabled => true %>

      <script type="text/javascript">
        $(document).ready(function() {
          $('input[name="date_range[date_attribute]"]').on('click change', function(e) {
            if ($('input[name="date_range[date_attribute]"]:checked').val() === "") {
              $('#refresh_data_table').prop( "disabled", true )
            } else {
              $('#refresh_data_table').prop( "disabled", false )
            };
          });
        });
      </script>

    <%end%>

  </div>
</fieldset>

<%=
  scope_minus_type = @scope.dup
  scope_minus_type.filters.reject! { |f| f.attribute == 'type' }
  render(:partial => 'shared/active_filters', :locals  => {
    :scope => scope_minus_type,
    :model => ResourceUsage,
  })
%>

<div class="pagination"></div>

<%=
  dynamic_scoped_table(@resource_usages,
    :id    => 'resource_usage_dynamic_table',
    :class => [ :resource_list ],
    :scope => @scope,
    :order_map         => {
      :user            => { :a => 'users.name',               :j => User           },
      :group           => { :a => 'groups.name',              :j => Group          },
      :data_provider   => { :a => 'data_providers.name',      :j => DataProvider   },
      :remote_resource => { :a => 'remote_resources.name',    :j => RemoteResource },
      :tool            => { :a => 'tools.name',               :j => Tool           },
      :tool_config     => { :a => 'tool_config.version_name', :j => ToolConfig     },
    },
    :filter_map        => {
      :user            => { :a => 'user_id'             },
      :group           => { :a => 'group_id'            },
      :data_provider   => { :a => 'data_provider_id'    },
      :remote_resource => { :a => 'remote_resource_id'  },
      :tool            => { :a => 'tool_id'             },
      :tool_config     => { :a => 'tool_config_id'      },
    },
  ) do |t|
%>
  <%
    t.pagination

    #t.column("Usage Type", :type)

    t.column(t('.columns.date'), :created_at,
      :sortable => true,
    ) do |ru|
      html_tool_tip(to_localtime(ru.created_at, :datetime), :offset_x => 0, :offset_y => 20) do
        (ru.created_at.in_time_zone.strftime("%a %b %d, %Y at %H:%M:%S %Z") + "<br>" +
         t('ago_time', time: pretty_elapsed(Time.now - ru.created_at, :num_components => 2))).html_safe
      end
    end

    # --- Main Values ---

    t.column((@maintype =~ /Space/ ? t('.columns.disk_space') : t('.columns.time')),
      :value,
      :sortable => true,
    ) { |ru| pretty_resource_usage_value(ru) }

    if @maintype =~ /ForUserfile/
      t.column(t('activerecord.models.userfile', count: 1), :userfile,
        :sortable => false,
      ) { |ru| link_to_userfile_if_accessible(ru.userfile) }
    else
      t.column(t('activerecord.models.cbrain_task', count: 1), :cbrain_task,
        :sortable => false,
      ) do |ru|
        task = ru.cbrain_task
        if task
          link_to_task_if_accessible(ru.cbrain_task, nil, :name => ru.cbrain_task.pretty_name) +
          "&nbsp;".html_safe +
          "(" + colored_status(task.status) + ")"
        end
      end
    end


    # --- Common Columns: User, Group, Server ---

    t.column(t('owner'), :user,
      :sortable => true,
      :filters  => default_filters_for(@base_scope, User)
    ) { |ru| link_to_user_if_accessible(ru.user) }

    t.column(t('activerecord.models.group', count: 1), :group,
      :sortable => true,
      :filters  => default_filters_for(@base_scope, Group)
    ) { |ru| link_to_group_if_accessible(ru.group) }

    t.column(t('activerecord.models.remote_resource', count: 1), :remote_resource,
      :sortable => true,
      :filters  => default_filters_for(@base_scope, RemoteResource)
    ) { |ru| link_to_bourreau_if_accessible(ru.remote_resource) }

    t.column(t('.columns.cached_owner_type'), :user_type,
      :sortable => true,
      :filters  => default_filters_for(@base_scope, :user_type)
    )

    t.column(t('.columns.cached_owner_login'), :user_login,
      :sortable => true,
      :filters  => default_filters_for(@base_scope, :user_login)
    )

    t.column(t('.columns.cached_project_type'), :group_type,
      :sortable => true,
      :filters  => default_filters_for(@base_scope, :group_type)
    )

    t.column(t('.columns.cached_project_name'), :group_name,
      :sortable => true,
      :filters  => default_filters_for(@base_scope, :group_name)
    )

    t.column(t('.columns.cached_server_name'), :remote_resource_name,
      :sortable => true,
      :filters  => default_filters_for(@base_scope, :remote_resource_name)
    )

    if @maintype =~ /ForUserfile/

      # --- Userfile Columns ---

      t.column(t('.columns.cached_userfile_type'), :userfile_type,
        :sortable => true,
        :filters  => default_filters_for(@base_scope, :userfile_type)
      )

      t.column(t('.columns.cached_userfile_name'), :userfile_name,
        :sortable => true,
      )

      # --- DataProvider Columns ---

      t.column(t('activerecord.models.data_provider', count: 1), :data_provider,
        :sortable => true,
        :filters  => default_filters_for(@base_scope, DataProvider)
      ) { |ru| link_to_data_provider_if_accessible(ru.data_provider) }

      t.column(t('.columns.cached_provider_type'), :data_provider_type,
        :sortable => true,
        :filters  => default_filters_for(@base_scope, :data_provider_type)
      )

      t.column(t('.columns.cached_provider_name'), :data_provider_name,
        :sortable => true,
        :filters  => default_filters_for(@base_scope, :data_provider_name)
      )

    elsif @maintype =~ /ForCbrainTask/

      # --- CbrainTask Columns ---

      t.column(t('.columns.cached_task_type'), :cbrain_task_type,
        :sortable => true,
        :filters  => scoped_filters_for(
          @base_scope, @scope, :cbrain_task_type,
          format: lambda do |format_info|
            value, label, base, view = *format_info
            label = label.sub(/^CbrainTask::/,"")
            {
              :value     => value,
              :label     => t('.labels.task_type', label: label, base: base),
              :indicator => view,
              :empty     => view == 0
            }
          end
        )
      ) { |ru| (ru.cbrain_task_type || "").sub(/CbrainTask::/,"") }

      t.column(t('.columns.cached_task_status'), :cbrain_task_status,
        :sortable => true,
        :filters  => default_filters_for(@base_scope, :cbrain_task_status)
      ) { |ru| colored_status(ru.cbrain_task_status) }

      # --- Tool Columns ---

      t.column(t('activerecord.models.tool', count: 1), :tool,
        :sortable => true,
        :filters  => default_filters_for(@base_scope, Tool)
      ) { |ru| ru.tool ? link_to(ru.tool.name, tool_path(ru.tool.id)) : "" }

      t.column(t('.columns.cached_tool_name'), :tool_name,
        :sortable => true,
        :filters  => default_filters_for(@base_scope, :tool_name)
      )

      # --- ToolConfig Columns ---

      t.column(t('version', count: 1), :tool_config,
        :sortable => true,
        :filters  => scoped_filters_for(
          @base_scope, @view_scope, :tool_config_id,
          scope: @scope,
          label: 'tool_configs.version_name',
          association: [ToolConfig, 'id', 'tool_config_id']
        )
      ) { |ru| ru.tool_config ? link_to(ru.tool_config.version_name, tool_config_path(ru.tool_config)) : "" }

      t.column(t('.columns.cached_version'), :tool_config_version_name,
        :sortable => true,
        :filters  => default_filters_for(@base_scope, :tool_config_version_name)
      )

    end

  %>

<% end %>
