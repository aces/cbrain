  <div class="menu-bar">
    <%= link_to t('.links.new_request'), new_signup_path, :class => "button" %>

    <%
       # Careful, the labels of the buttons below are used by the controller
       # to select which multi action to perform. Change them at both places.
    %>

    <%= external_submit_button t('delete'),                 'signups_table_form', :class => "button", :name => 'operation', :value => 'delete', :data => { :confirm =>  t('.delete_confirm') } %>
    <%= external_submit_button t('.buttons.adjust_login'),          'signups_table_form', :class => "button", :name => 'operation', :value => 'fix_login' %>
    <%= external_submit_button t('.buttons.resend_confirm_email'),  'signups_table_form', :class => "button", :name => 'operation', :value => 'reconfirm' %>
    <%= external_submit_button t('.buttons.toggle_hidden'),         'signups_table_form', :class => "button", :name => 'operation', :value => 'toggle_hidden' %>

    <% if @scope.custom[:view_hidden] %>
      <%= link_to t('.links.hide_hidden_records'), signups_path(:view_hidden => false), :class => "button" %>
    <% else %>
      <%= link_to t('.links.show_all_records'),    signups_path(:view_hidden => true),  :class => "button" %>
    <% end %>

    <%= scope_filter_link(t('.links.latest_todo'), "signups#index", :replace,
          [ { :a => :approved_by, :v => '' }, { :a => :confirmed, :v => 1 } ],
          :url => { :controller => :signups, :action => :index, :view_hidden => false },
          :link => { :class => "button" }
        )
    %>
  </div>

  <p>

<%= form_tag( { :action => :multi_action }, :id => 'signups_table_form', :method => :post) do %>

  <%=
    render(:partial => 'shared/active_filters', :locals  => {
      :scope => @scope,
      :model => Signup,
    })
  %>

  <div class="pagination">
    <span class="page_links">
      (
      <%= t('.links.signup_request', count: @signups.total_entries) %>
      <% if @num_hidden && @num_hidden > 0 %>
        , <%= @num_hidden %> <%= t('hidden') %> <%= hidden_icon %>
      <% end %>
      )
    </span>
  </div>

  <%=
    dynamic_scoped_table(@signups,
      :class      => [ :resource_list ],
      :id         => "signups_table",
      :order_map  => {
        :created_at     =>  { :a => 'signups.created_at' },
        :institution    =>  { :a => 'signups.institution' },
        :email          =>  { :a => 'signups.email' },
      },
      :scope      => @scope
    ) do |t|
  %>
    <%
      t.paginate
      t.row do |d|
        {
          :select_param => 'reqids[]',
          :select_value => d.id,
          :html => { 'data-id' => d.id }
        }
      end
    %>

    <%
      t.column(t('.columns.name'), :last,
        :sortable => true
      ) { |d| link_to d.full_name, signup_path(d) }
    %>

    <%
      t.column(t('.columns.edit'), :edit) do |d|
    %>
      <%= link_to t('.links.edit'), edit_signup_path(d), :class => 'action_link' %>
    <% end %>

    <%
      t.column(t('.columns.email'), :email,
        :sortable => true
      ) { |d| red_if((d.dup_email? and not d.approved?), d.email) }
    %>

    <%
      t.column(t('.columns.position'), :position,
        :sortable => true,
        :hidden   => true,
        :filters  => default_filters_for(@base_scope, :position)
      )
    %>

    <%
      t.column(t('.columns.department'), :department,
        :sortable => true,
        :hidden   => true,
        #:filters  => default_filters_for(@base_scope, :department)
      )
    %>

    <%
      t.column(t('.columns.institution'), :institution,
        :sortable => true,
        #:filters  => default_filters_for(@base_scope, :institution)
      )
    %>

    <%
      t.column(t('.columns.country'), :country,
        :sortable => true,
        :filters => default_filters_for(@base_scope, :country)
      )
    %>

    <%
      t.column(t('.columns.username'), :login,
        :sortable => true
      )
    %>

    <%
      t.column(t('.columns.comments'), :comment) do |d|
        html_tool_tip(crop_text_to(40, d.comment), :offset_x => 0, :offset_y => 20) do
          simple_format(d.comment, :sanitize => true)
        end if d.comment.present?
      end
    %>

    <%
      t.column(t('.columns.private_comments'), :admin_comment) do |d|
        html_tool_tip(crop_text_to(40, d.admin_comment), :offset_x => 0, :offset_y => 20) do
          simple_format(d.admin_comment, :sanitize => true)
        end if d.admin_comment.present?
      end
    %>

    <%
      t.column(t('.columns.in_cbrain'), :user) do |d|
        user = User.where(:id => d.user_id).first
        if (user)
          link_to_user_with_tooltip(user)
        else
          t('none_parentheses')
        end
      end
    %>

    <%
      t.column(t('.columns.portal'), :remote_resource) do |d|
        portal = d.remote_resource
        if (portal)
          link_to_bourreau_if_accessible(portal)
        else
          t('none_parentheses')
        end
      end
    %>

    <%
      t.column(t('.columns.origin'), :form_page,
        :sortable => true
      )
    %>

    <%
      t.column(t('.columns.created'), :created_at,
        :sortable => true
      ) do |d|
        html_tool_tip(to_localtime(d.created_at, :datetime), :offset_x => 0, :offset_y => 20) do
          t('.tooltips.updated_at', time: d.updated_at.in_time_zone.strftime("%a %b %d, %Y at %H:%M:%S %Z")).html_safe
        end
      end
    %>

    <%
      t.column(t('.columns.approved_by'), :approved_by,
        :sortable => true,
        :filters => [ { :value => nil,
                        :label => t('.labels.not_approved'),
                        :indicator => @base_scope.where(:approved_by => nil).count,
                      }
                    ] +
                    default_filters_for(@base_scope, :approved_by)
      )
    %>

    <%
      t.column(t('.columns.status'), :status) do |d|
    %>
      <%= render :partial => 'status', :locals => { :signup => d, :multi_lines => false } %>
    <% end %>

  <% end %>
<% end %>

