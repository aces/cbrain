<% title t('.title') %>

<h1><%= t('.headings.main') %></h1>

<% if current_user.present? && current_user.has_role?(:admin_user) %>

  <% if @signup.remote_resource %>
    <%= t('.paragraphs.made_from_portal_html', portal: link_to_bourreau_if_accessible(@signup.remote_resource), form_page: @signup.form_page) %>
  <% end %>

  <%= t('.paragraphs.admin_can_edit_html', link: link_to(t('edit').downcase, :action => :edit)) %><p>

  <% if ! @signup.approved? %>

    <% if @signup.dup_login? %>
      <span class="warning"><%= t('.paragraphs.login_conflict') %></span>
    <% else %>
      <%= t('.paragraphs.can_approve_html', link: link_to(t('.links.approve'), new_user_path(:signup_id => @signup.id), :class => 'action_link')) %>
    <% end %>

    <% if ! @signup.confirmed? %>
      <span class="warning"><%= t('.paragraphs.not_confirmed') %></span>
    <% else %>
      <%= t('.paragraphs.confirmed') %>
    <% end %>

    <p>
    <%= t('.paragraphs.resend_admin_html', link: link_to(t('.links.email_confirmation_request'), resend_confirm_signup_path(@signup), :method => :post)) %>

  <% end %>

<% else %>

  <p>
  <%= t('.paragraphs.edit_session_note_html', link: link_to(t('edit'), :action => :edit)) %>

<% end %>

<% if current_user.blank? && ! @signup.confirmed? %>
  <p>
  <%= t('.paragraphs.confirmation_sent') %>
  <p>
  <%= t('.paragraphs.resend_user_html', link: link_to(t('.links.email_confirmation_request'), resend_confirm_signup_path(@signup), :method => :post)) %>
<% end %>

<p>
<%= t('.paragraphs.delete_html', link: link_to(t('delete'), signup_path(@signup), :action => :destroy, :method => :delete, :data => { :confirm => t('confirm_delete', name: @signup.full_name) })) %>

<p>
<%= t('.paragraphs.summary_intro') %>

<p>
  <table class="simple bordered">

  <tr>
    <th><%= t('.headings.full_name') %></th>
    <td><%= @signup.full_name %></td>
  </tr>

  <tr>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
  </tr>

  <tr>
    <th><%= t('.headings.login') %></th>
    <td><%= @signup.login.presence || t('none_parentheses') %></td>
  </tr>

  <tr>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
  </tr>

  <tr>
    <th><%= t('.headings.institution') %></th>
    <td><%= @signup.institution %></td>
  </tr>

  <tr>
    <th><%= t('.headings.department') %></th>
    <td><%= @signup.department %></td>
  </tr>

  <tr>
    <th><%= t('.headings.position') %></th>
    <td><%= @signup.position %></td>
  </tr>

  <tr>
    <th><%= t('.headings.affiliation') %></th>
    <td><%= @signup.affiliation %></td>
  </tr>

  <tr>
    <th><%= t('.headings.email') %></th>
    <td><%= @signup.email %></td>
  </tr>

  <tr>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
  </tr>

  <tr>
    <th><%= t('.headings.street1') %></th>
    <td><%= @signup.street1 %></td>
  </tr>

  <tr>
    <th><%= t('.headings.street2') %></th>
    <td><%= @signup.street2 %></td>
  </tr>

  <tr>
    <th><%= t('.headings.city') %></th>
    <td><%= @signup.city %></td>
  </tr>

  <tr>
    <th><%= t('.headings.province') %></th>
    <td><%= @signup.province %></td>
  </tr>

  <tr>
    <th><%= t('.headings.country') %></th>
    <td><%= @signup.country %></td>
  </tr>

  <tr>
    <th><%= t('.headings.postal_code') %></th>
    <td><%= @signup.postal_code %></td>
  </tr>

  <tr>
    <th><%= t('.headings.time_zone') %></th>
    <td><%= @signup.time_zone %></td>
  </tr>

  <tr>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
  </tr>

  <% if @signup.comment.present? %>

    <tr>
      <th><%= t('.headings.comment') %></th>
      <td><pre><%= @signup.comment %></pre></td>
    </tr>

    <tr>
      <td>&nbsp;</td>
      <td>&nbsp;</td>
    </tr>

  <% end %>

  <% if current_user.present? && current_user.has_role?(:admin_user) %>

    <tr>
      <th><%= t('.headings.admin_comments') %></th>
      <td><pre><%= @signup.admin_comment %></pre></td>
    </tr>

    <tr>
      <td>&nbsp;</td>
      <td>&nbsp;</td>
    </tr>

  <% end %>

  <tr>
    <th><%= t('.headings.status_of_request') %></th>
    <td>
      <%= render :partial => 'status', :locals => { :signup => @signup, :multi_lines => true } %>
    </td>
  </tr>

  </table>

