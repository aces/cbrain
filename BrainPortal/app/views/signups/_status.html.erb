<%
#
# Partial with these locals:
#
# signup          : signup object
# multi_lines     : if true each status info separated by a BR
#
%>

<% newline = (multi_lines.present? rescue false) ? "<br>".html_safe : "" %>

<%= hidden_icon if signup.hidden? %>

<% if signup.approved? %>
  <% if newline.present? && current_user.present? && current_user.has_role?(:admin_user) %>
    <%= t('.approved_by', name: signup.approved_by) %><%= newline %>
  <% end %>
  <%= t('.approved_at', time: signup.approved_at) %>
<% else %>

  <% if signup.confirmed? %>
    <span><strong><%= t('.email_confirmed') %></strong></span>
  <% else %>
    <span class="warning"><%= t('.warnings.email_unconfirmed') %></span>
  <% end %>
  <%= newline %>

  <% if signup.dup_email? %>
    <span class="warning"><%= t('.warnings.conflicting_email') %></span><%= newline %>
  <% end %>

  <% if signup.dup_login? %>
    <span class="warning"><%= t('.warnings.login_conflict') %></span>
  <% else %>
    <% if current_user.present? && current_user.has_role?(:admin_user) %>
      <%= link_to t('.links.approve'), new_user_path(:signup_id => signup.id), :class => 'action_link' %>
    <% end %>
  <% end %>

<% end %>

