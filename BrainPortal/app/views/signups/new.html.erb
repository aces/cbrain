<% title t('.title') %>

<%= form_for @signup, :url => {:action => (@signup.new_record? ? "create" : "update"), :id => @signup.id} do |f| %>
  <%= error_messages_for @signup %>
  <%= hidden_field_tag(:auth_spec, (@auth_spec.to_s.presence || Time.now.to_i.to_s)) %>

  <div class="generalbox">
    <p class="warning"> <%= t('.warnings.mandatory_fields') %></p>

    <fieldset class="groupentry">

      <legend>
        <%= t('.legends.personal_info') %>
      </legend>

      <div class="tree-column-grid">

        <%= f.label(:title, t('.labels.title')) %>
        <%= f.text_field :title %>

        <%= t('.paragraphs.title_html') %>

        <%= f.label(:first, t('.labels.first')) %>
        <%= f.text_field :first %>
        <br>

        <%= f.label(:middle, t('.labels.middle')) %>
        <%= f.text_field :middle %>
        <br>

        <%= f.label(:last, t('.labels.last')) %>
        <%= f.text_field :last %>
        <br>

        <%= f.label(:login, t('.labels.login')) %>
        <%= f.text_field :login %>
        <%= t('.paragraphs.login_html') %>
      </div>
    </fieldset>

    <br>

    <fieldset class="groupentry">

      <legend>
        <%= t('.legends.institution_info') %>
      </legend>

      <div class="two-column-grid">

        <%= f.label(:institution, t('.labels.institution')) %>
        <%= f.text_field :institution, :size => 60 %>

        <%= f.label(:department, t('.labels.department')) %>
        <%= f.text_field :department, :size => 60 %>

        <%= f.label(:position, t('.labels.position')) %>
        <%= f.select :position, options_for_select(
            [[t('.selects.select_one'), ""], [t('.selects.position_options.faculty'), "Faculty"],
                                     [t('.selects.position_options.postdoctoral'), "Postdoctoral"],
                                     [t('.selects.position_options.phd_candidate'), "PhD. candidate"],
                                     [t('.selects.position_options.masters_student'), "Masters student"],
                                     [t('.selects.position_options.student'), "Student"],
                                     [t('.selects.position_options.researcher'), "Researcher"],
                                     [t('.selects.position_options.other'), "Other"]
            ],
            @signup.position)
        %>

        <%= f.label(:affiliation, t('.labels.affiliation')) %>
        <%= f.select :affiliation, options_for_select(
            [[t('.selects.select_one'), ""], [t('.selects.affiliation_options.academic'), "Academic"],
                                     [t('.selects.affiliation_options.private_sector'), "Private sector"],
                                     [t('.selects.affiliation_options.government'), "Government"],
                                     [t('.selects.affiliation_options.non_profit'), "Non-profit"],
                                     [t('.selects.affiliation_options.other'), "Other"]
            ],
            @signup.affiliation)
        %>

        <%= f.label(:email, t('.labels.email')) %>
        <%= f.text_field :email, :size => 60 %>

        <div></div>
        <%= t('.paragraphs.email_html') %>

        <%= f.label(:street1, t('.labels.street1')) %>
        <%= f.text_field :street1, :size => 60 %>

        <%= f.label(:street2, t('.labels.street2')) %>
        <%= f.text_field :street2, :size => 60 %>

        <%= f.label(:city, t('.labels.city')) %>
        <%= f.text_field :city, :size => 30 %>

        <%= f.label(:province, t('.labels.province')) %>
        <%= f.text_field :province, :size => 30 %>

        <%= f.label(:country, t('.labels.country')) %>
        <%= f.text_field :country, :size => 30 %>

        <%= f.label(:postal_code, t('.labels.postal_code')) %>
        <%= f.text_field :postal_code, :size => 8 %>

        <%= f.label(:time_zone, t('time_zone')) %>
        <%= f.time_zone_select :time_zone,
                               ActiveSupport::TimeZone.all.select {|t| t.name =~ /canada/i},
                               {:default => ActiveSupport::TimeZone['Eastern Time (US & Canada)'], :include_blank => true}
        %>

        <%= f.label(:comment, t('.labels.comment')) %>
        <%= f.text_area :comment, :cols => 80, :rows => 5 %>
        <br>
        <%= t('.paragraphs.comment_html') %>

      <% if current_user.present? && current_user.has_role?(:admin_user) %>
          <%= f.label(:admin_comment, t('.labels.admin_comment')) %>
          <%= f.text_area :admin_comment, :cols => 80, :rows => 5 %>
      <% end %>
      </div>
      <br>
    </fieldset>
    <br>
    <div class="centered">
      <%= f.submit(@signup.new_record? ? t('.submits.request_account') : t('.submits.update_request')) %>
    </div>

    <%= t('.paragraphs.privacy_note') %></b>

    <% if RemoteResource.current_resource.support_email.present? %>
      <br>
      <%= t('.contact_html', email: link_to(RemoteResource.current_resource.support_email, "mailto:#{RemoteResource.current_resource.support_email}")) %>
    <% end %>
  </div>
<% end %>
