<% title t('.title') %>

<% if @view == 'by_tool' || @view == 'by_bourreau' %>
  <%
    if @view == 'by_bourreau'
      resources = @bourreaux
      versus    = @tools
    else
      resources = @tools
      versus    = @bourreaux
    end
  %>
  <h1><%= t('.headings.by', type: @view == 'by_bourreau' ? t('.headings.execution_server') : t('.headings.tool', count: 1)) %></h1>
  <% resources.each do |resource| %>
    <p>
    <%= render :partial => 'by_resource',
               :locals  => { :resource => resource,
                             :versus   => versus,
                             :users    => @users,
                            }
    %>
  <% end %>
<% elsif @view == 'by_user' %>
  <h1><%= t('.headings.access_by_user') %></h1>
  <% @users.each do |user| %>
    <p>
    <%= render :partial => 'by_user',
               :locals  => { :bourreaux => @bourreaux,
                             :user      => user,
                             :tools     => @tools,
                            }
    %>
  <% end %>
<% end %>

<p>

<h1><%= t('.headings.quick_links') %></h1>

<h5><%= t('.headings.by_server_html', link: link_to(t('.all.of_them'), :action => :report, :view => 'by_bourreau')) %></h5>
<%= array_to_table(Bourreau.all.sort { |a,b| a.name <=> b.name }, :table_class => 'simple', :rows => 1 ) do |bourreau,r,c| %>
  <%= link_to bourreau.name, :action => :report, :bourreau_id => bourreau.id %>
<% end %>

<p>

<h5><%= t('.headings.by_tool_html', link: link_to(t('.all.of_them'), :action => :report, :view => 'by_tool')) %></h5>
<%= array_to_table(Tool.all.sort { |a,b| a.name <=> b.name }, :table_class => 'simple', :td_class => 'no_wrap' ) do |tool,r,c| %>
  <%= link_to tool.name, :action => :report, :tool_id => tool.id %>
<% end %>

<p>

<h5><%= t('.headings.by_user') %></h5>
<%= array_to_table(User.all.sort { |a,b| a.login <=> b.login }, :table_class => 'simple' ) do |user,r,c| %>
  <%= link_to user.login, :action => :report, :user_id => user.id %>
<% end %>

<p>

<h5><%= t('.headings.by_combination') %></h5>

<%= form_tag( { :action => :report }, :method => :get) do %>

<%= t('.labels.execution_server') %>
<%= bourreau_select :bourreau_id,
                    {
                      :selector => (params[:bourreau_id] || ""),
                      :offline_is_ok => true,
                    },
                    { :include_blank => t('.all.servers_or') } %>

<%= t('.labels.tool') %>
<% toollist = Tool.all.sort { |a,b| a.name <=> b.name } %>
<%= select_tag :tool_id, options_for_select( [ [ t('.all.tools_or'), "" ] ] + (toollist.collect { |t| [ t.name, t.id.to_s ] } ), params[:tool_id] ) %>

<%= t('.labels.user') %>
<%= user_select :user_id, { :selector => params[:user_id] }, { :include_blank => t('.all.users_or') } %>

<%= t('.labels.view_by') %>
<%= select_tag :view, options_for_select( [ [ t('.pick_best'), "" ], [ t('.view_by.server'), 'by_bourreau' ], [ t('.view_by.tool'), 'by_tool' ], [ t('.view_by.user'), 'by_user' ] ], params[:view] ) %>

<%= submit_tag t('.submit') %>

<% end %>

