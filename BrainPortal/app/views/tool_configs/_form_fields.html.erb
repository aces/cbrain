<%= error_messages_for @tool_config %>

<%= show_table_context(@tool_config) do |cf| %>

  <%= cf.hidden_field :tool_id     %>
  <%= cf.hidden_field :bourreau_id %>

  <% if @tool_config.tool_id && @tool_config.bourreau_id %>

    <%= show_table(@tool_config, :form_helper => cf, :header => t('.headings.version_config_info'),
                                 :edit_condition => check_role(:admin_user)) do |t| %>

      <% t.edit_cell(:version_name, :header => t('.headings.version')) do |f| %>
        <%= f.text_field :version_name, :size => 20 %>
        <div class="field_explanation">
          <%= t('.field_explanations.version') %>
        </div>
      <% end %>

      <% t.cell(t('created')) { @tool_config.created_at.present? ? to_localtime(@tool_config.created_at,:datetime) : "" } %>

      <% t.edit_cell(:group_id, :header => t('.headings.project_access'),
                     :content => link_to_group_if_accessible(@tool_config.group_id)) do %>
        <%= group_select "tool_config[group_id]", @tool_config.group_id %>
      <% end %>

      <% t.cell(t('last_updated')) { @tool_config.updated_at.present? ? to_localtime(@tool_config.updated_at,:datetime) : "" } %>

      <% t.edit_cell(:ncpus, :header => t('.headings.suggested_cpus')) do |f| %>
        <%= f.select :ncpus, [1, 2, 3, 4, 5, 6, 7, 8, 10, 12, 14, 16, 20, 24, 32, 36, 40, 48, 56, 64, 128, 192, 256,
                              320, 384, 512] %>
      <% end %>

      <% t.empty_cell %>

      <% t.edit_cell(:description, :header => t('.headings.description'), :show_width => 2, :content => full_description(@tool_config.description)) do |f| %>
        <%= f.text_area :description, :rows => 10, :cols => 120 %>
        <div class="wide_field_explanation">
          <%= t('.field_explanations.description') %>
        </div>
      <% end %>

      <% t.edit_cell(:inputs_readonly, :header => t('.headings.inputs_readonly'), :show_width => 2) do |f| %>
        <%= f.check_box :inputs_readonly %>
        <div class="wide_field_explanation">
          <%= t('.field_explanations.inputs_readonly_html') %>
        </div>
      <% end %>

      <% desc_origin, desc_path = @tool_config.boutiques_descriptor_origin_keyword %>
      <% desc_content  = "<strong>(#{desc_origin.capitalize})</strong> ".html_safe %>
      <%
         if desc_path.present?
           show_btq_link = link_to("(#{t('show')})", boutiques_descriptor_tool_config_path(@tool_config))
           desc_content += show_btq_link
         end
      %>
      <% t.edit_cell(:boutiques_descriptor_path, :header => t('.headings.boutiques_path'), :show_width => 2, :content => desc_content) do |f| %>
        <%= f.text_field :boutiques_descriptor_path, :size => 80 %>
        <div class="wide_field_explanation">
          <%= t('.field_explanations.boutiques_path_html') %>
        </div>
      <% end %>

    <% end %>

  <% end %>



  <%= show_table(@tool_config, :form_helper => cf, :header => t('.headings.exec_server_control'), :edit_condition => check_role(:admin_user)) do |t| %>

    <% t.edit_cell(:extra_qsub_args, :header => t('.headings.extra_qsub'), :show_width => 2) do |f| %>
      <%= f.text_field :extra_qsub_args, :size => 80 %>
      <div class="wide_field_explanation">
        <%= t('.field_explanations.extra_qsub_html') %>
      </div>
    <% end %>

  <% end %>



  <%= show_table(@tool_config, :form_helper => cf, :header => t('.headings.env_vars'),
                               :edit_condition => check_role(:admin_user)) do |t| %>

    <% t.row do %>
      <%= t('.env_vars_note_top') %>
    <% end %>

    <% @tool_config.env_array.each do |env_name_value| %>
      <% env_name  = env_name_value[0] %>
      <% env_value = env_name_value[1] %>
      <% render :partial => 'env_key_value_pair',
                :locals => { :env_name => env_name, :env_value => env_value, :t => t }
      %>
    <% end %>

    <% 1.upto(5) do %>
      <% render :partial => 'env_key_value_pair',
                :locals => { :env_name => "", :env_value => "", :t => t }
      %>
    <% end %>

    <% t.row do %>
      <%= t('.env_vars_note_bottom') %>
    <% end %>

  <% end %>



  <%= show_table @tool_config, :form_helper => cf, :header => t('.headings.bash_prologue'),
                 :edit_condition => check_role(:admin_user) do |t| %>

    <% t.edit_cell(:script_prologue, :content => full_description(@tool_config.script_prologue),
                   :no_header => true) do |f| %>
      <%= f.text_area :script_prologue, :cols => 80, :rows => 10 %>

      <p>
      <div class="wide_field_explanation">
        <%= t('.prologue_explanation_html') %>
      </div>
    <% end %>

  <% end %>



  <%= show_table @tool_config, :form_helper => cf, :header => t('.headings.bash_epilogue'),
                 :edit_condition => check_role(:admin_user) do |t| %>

    <% t.edit_cell(:script_epilogue, :content => full_description(@tool_config.script_epilogue),
                   :no_header => true) do |f| %>
      <%= f.text_area :script_epilogue, :cols => 80, :rows => 10 %>

      <p>
      <div class="wide_field_explanation">
        <%= t('.epilogue_explanation_html') %>
      </div>
    <% end %>

  <% end %>



  <%= show_table(@tool_config, :form_helper => cf, :header => t('.headings.container'), :edit_condition => check_role(:admin_user)) do |t| %>
    <% t.edit_cell(:container_engine, :header => t('tool_configs.common.container_engine')) do |f| %>
      <%= f.select :container_engine, [[t('.container_none'), ''], ['Docker', 'Docker'], ['Singularity', 'Singularity']], :title => t('.container_type_title') %>
    <% end %>

    <% t.edit_cell(:container_index_location, :header => t('.headings.container_index')) do |f| %>
      <%= f.text_field :container_index_location %>
      <div class="field_explanation">
        <%= t('.field_explanations.container_index_html') %>
      </div>
    <% end %>

    <% t.edit_cell(:containerhub_image_name, :header => t('.headings.container_image_name')) do |f| %>
      <%= f.text_field :containerhub_image_name %>
        <div class="field_explanation">
        <%= t('.field_explanations.container_image_name') %>
        </div>
    <% end %>

    <% t.edit_cell :containerhub_image_name, :content => link_to_userfile_if_accessible(@tool_config.container_image), :header => t('.headings.container_image_id') do |f| %>
      <%= f.text_field :container_image_userfile_id %>
      <div class="field_explanation">
        <%= t('.field_explanations.container_image_id') %>
      </div>
    <% end %>

    <% t.edit_cell(:singularity_overlays_specs, :header => t('.headings.singularity_overlays'), :show_width => 2, :content => full_description(@tool_config.singularity_overlays_specs)) do |f| %>
      <%= f.text_area :singularity_overlays_specs, :rows => 6, :cols => 120 %>
        <div class="wide_field_explanation">
          <%= t('.field_explanations.singularity_overlays_html') %>
        </div>
    <% end %>

    <% t.edit_cell(:container_exec_args, :header => t('.headings.misc_singularity'), :show_width => 2) do |f| %>
      <%= f.text_field :container_exec_args, :size => 60 %>
      <div class="field_explanation">
        <%= t('.field_explanations.container_exec_args_html') %>
      </div>
    <% end %>

    <% t.boolean_edit_cell('tool_config[singularity_use_short_workdir]',
         (@tool_config.singularity_use_short_workdir ? "1" : "0"),
         "1", "0",
         :header => t('.headings.short_workdir'))
    %>

  <% end %>


  <% bourreau = @tool_config.bourreau %>

  <p>

    <fieldset class="groupentry" style="margin: 0.2em;">
      <legend><%= t('.legends.merge') %></legend>
      <div class="wide_field_explanation">
        <%= t('.merge_intro') %>
        <p>
        <% if @tool_config.tool_id && @tool_config.bourreau_id %>
          <%= t('.merge_explanation_both') %>
        <% else %>
          <%= t('.merge_explanation_env') %>
        <% end %>
      </div>

      <%= tool_config_select :merge_from_tc_id, {:allow_offline => true}, { :include_blank => t('.merge_from') } %>
      <%= submit_tag t('.submits.merge_preview'), :name => :merge %><br/>

      <hr>

      <%= submit_tag t('.submits.save_everything'), :name => :update %>

      <% if ! @tool_config.new_record? %>
        <%= submit_tag t('.submits.reload_original'), :name => :cancel %>
      <% end %>

      <div class="wide_field_explanation">
        <%= t('.merge_note') %>
      </div>
    </fieldset>

<% end # show_table_context %>
