<% title t('.title') %>

<% if @descriptor.present? %>

    <%= t('.present_html', tool: @tool_config.tool.name, server: @tool_config.bourreau.name) %>
    <p>
    <pre><%= @prettify ? @descriptor.super_pretty_json : JSON.pretty_generate(@descriptor) %></pre>

<% else %>

    <%= t('.absent_html', tool: @tool_config.tool.name, server: @tool_config.bourreau.name) %>

<% end %>
