<div name="dataprovider_files" class="index_block">

  <h2>
    <%= t('.headings.main', name: @provider.name) %>
    <% if @as_user != current_user %>
      <%= t('.headings.browsing_as_html', login: @as_user.login) %>
    <% end %>
  </h2>

  <% if @provider.has_browse_path_capabilities? %>
    <%= render :partial => 'dp_show_path' %>
  <% end %>

  <div class="pagination">
    <div class="pagination_left_side">
      <%= t('.register_files_as') %>
      <%= master_select("file_select", [t('select_placeholder')] + SingleFile.valid_file_classes.map(&:pretty_type).sort) %>,
      <%= t('.and_directories_as') %>
      <%= master_select("directory_select", [t('select_placeholder')] + FileCollection.valid_file_classes.map(&:pretty_type).sort) %>
    </div>

    <div class="pagination_right_side">
      <%= t('search_by_name') %> <%= ajax_search_box("name_like", browse_data_provider_path) %>
    </div>
  </div>

  <%=
    render(:partial => 'shared/active_filters', :locals  => {
      :scope => @scope,
      :model => nil
    })
  %>

  <%=
    dynamic_scoped_table(@files,
      :id           => 'dp_browse_table',
      :class        => [:whole_width],
      :request_type => 'server_javascript',
      :scope        => @scope
    ) do |t|
  %>
    <%
      t.paginate

      t.row do |f|
        {
          :select_param => 'basenames[]',
          :select_value => f.name
        } if f.state_ok
      end

      t.column(t('.columns.name'), :name,
        :sortable => true
      ) { |f| f.name.force_encoding('UTF-8') }

      if @provider.has_browse_path_capabilities?
        t.column(t('.columns.changedir'), :changedir) do |f|
          if f.symbolic_type == :directory
            newpath  = @browse_path.to_s # turns nil into ''
            newpath += "/" if newpath.present?
            newpath += f.name
            ajax_link("&rdsh;".html_safe,
              browse_data_provider_path(@provider, :browse_path => newpath),
              :datatype => 'script', :class =>  'action_link',
            )
          end
        end
      end

      t.column(t('.columns.size'), :size,
        :sortable => true
      ) { |f| f.symbolic_type == :regular ? colored_pretty_size(f.size) : '-' }

      t.column(t('.columns.type'), :symbolic_type,
        :sortable => true,
        :filters  => filter_values_for(@fileinfolist, :symbolic_type,
          format: lambda do |format_info|
            value, label, count = *format_info
            { :value => value.to_s, :label => label.to_s.humanize, :indicator => count }
          end
        )
      ) do |f|
        next f.userfile.pretty_type if f.userfile
        next html_colorize(t('.unacceptable')) unless f.state_ok

        case f.symbolic_type
        when :regular
          base       = SingleFile
          html_class = 'file_select'
        when :directory
          base       = FileCollection
          html_class = 'directory_select'
        else
          next f.symbolic_type.to_s.humanize
        end

        select_tag('filetypes[]',
          options_for_select(
            base.valid_file_classes.map do |c|
              [c.pretty_type, "#{c.name}-#{f.name}"]
            end,
            class_param_for_name(f.name, base)
          ),
          :class => html_class
        )
      end

      t.column(t('.columns.last_modified'), :mtime, :sortable => true)  do |f|
       mtime = f.mtime
       next mtime.nil? ? '-' : to_localtime(Time.at(f.mtime), :datetime)
      end

      t.column(t('.columns.registered'), :registered) do |f|
          userfile = f.userfile
          next t('data_providers.common.no_word') unless userfile

          owner = t('.belongs_to_html', login: userfile.user.login) unless
            userfile.user_id == current_user.id
            t('.registered_with_owner_html',
              link: link_to(t('.links.registered'), { :controller => 'userfiles', :action => 'show', :id => userfile.id }),
              owner: owner
            )
        end

      t.column(t('.columns.note'), :message)
    %>
  <% end %>

</div>
