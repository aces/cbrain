  <table>
    <tr><th class="supertitle"><%= t('.headings.instructions') %></th></tr>
      <%= t('.paragraphs.ssh_configuration_html') %>

    <tr><td class="left_align medium_paragraphs">
      <pre>ssh-copy-id -f -i mykey.pub -p <%= @provider.remote_port.presence || '22' %> <%= @provider.remote_user.presence || '[username_from_config_above]' %>@<%= @provider.remote_host.presence || '[hostname_from_config_above]' %></pre>
    </td></tr>

      <%= t('.paragraphs.no_security_risk_html') %>

    <tr><th class="supertitle"><%= t('.headings.your_key') %></th></tr>

    <tr><td><pre class="ssh_key"><%= pretty_ssh_key @provider.user.ssh_key(create_it: true).public_key rescue t('.errors.fetching') %></pre></td></tr>

    <tr><td>
      <%= t('.links.download') %>
      <%= link_to "mykey.pub", "data:plain;charset=utf-8,#{url_encode(@provider.user.ssh_key(create_it: true).public_key) rescue t('.errors.fetching') }" , download: "mykey.pub" %>
    </td></tr>

  </table>

