<%= button_with_dropdown_menu(t('.button')) do %>

  <%= t('.paragraphs.register_html') %>
  <% if @provider.meta[:must_move].present? %>
  <%= t('.paragraphs.must_move_html') %>
  <% end %>
  <%= t('.paragraphs.cleanup_html') %>

  <strong><%= t('.headings.when_registering') %></strong>
  <br/>

  <table class="simple">
    <tr>
      <td class="centered">&darr; ... <%= t('.datas.assign_project') %> ... &darr;</td>
      <td class="centered">&darr; ... <%= t('.datas.move_or_copy') %> ... &darr;</td>
      <td class="centered">&darr; ... <%= t('.datas.to') %> ... &darr;
        <% main_dp_set = DataProvider.find_all_accessible_by_user(current_user).all.select { |dp| ! dp.is_browsable? } %>
        <%= html_tool_tip(t('.tool_tips.info'), :offset_y => 25, :offset_x => -200 ) do %>
          <%= data_providers_descriptions(main_dp_set) %>
        <% end %>
      </td>
      <td rowspan="2" class="centered">
        <%= hijacker_submit_button(
          t('.submit'),
          :name     => :register,
          :url      => url_for(:action => :register),
          :method   => :post,
          :datatype => :script,
          :class    => "button"
        ) %>
      </td>
    </tr>
    <tr>
      <td><%= group_select :other_group_id, {}, { :include_blank => t('.include_blanks.select_project') } %></td>

    <td>
    <% auto_do_options = [
                            [ t('.datas.move_option'), "MOVE" ],
                            [ t('.datas.copy_option'), "COPY" ]
                         ]
      # Disable the MOVE option if the DP is read only
      auto_do_options[0].push({:disabled => true}) if @provider.read_only?
      # Add an option to leave files on the DP if the DP allows it.
      auto_do_options.unshift( [t('.datas.do_nothing'), "" ] ) unless @provider.meta[:must_move].present?
    %>
    <%= select_tag :auto_do, options_for_select( auto_do_options ) %>
    </td>

    <td>
    <%= data_provider_select :other_data_provider_id,
        { :data_providers => main_dp_set },
      include_blanks:
        { :include_blank => t('.include_blanks.select_another_dp') }
    %>
    </td>
  </table>


  <P>
  <%= t('.notes.title_html') %>
  </P>

  <UL>
    <LI><%= t('.notes.start') %></LI>
    <LI><%= t('.notes.no_modify') %></LI>
    <LI><%= t('.notes.copy_progress_html') %></LI>
    <LI><%= t('.notes.copy_done_html') %></LI>
    <LI><%= t('.notes.move_done') %></LI>
    <LI><%= t('.notes.ignored') %></LI>
  </UL>

<% end %>

