<% title t('.title') %>

<h2><%= t('.headings.main') %></h2>

<%= error_messages_for(@provider) %>

<%= form_for @provider, :as => :data_provider, :url => { :action => "create_personal" }, :datatype => "script" do |f| -%>

  <div class="generalbox">

    <div title=<%= t('.titles.name') %>>
      <%= f.label :name, t('.labels.name') %><br>
      <%= f.text_field :name %>
      <%= t('.paragraphs.name_html') %>
    </div>

    <p>

    <div title=<%= t('.titles.description') %>>
      <%= f.label :description, t('.labels.description') %><br>
      <%= f.text_area :description, :rows => 3, :cols => 85 %>
      <%= t('.paragraphs.description_html') %>
    </div>

    <p>

    <div title=<%= t('.titles.group') %>>
      <%= f.label :group_id, t('.labels.group') %><br>
      <%= group_select("data_provider[group_id]", { :groups => @groups, :selector => @provider.group_id.to_s }) %>
      <%= t('.paragraphs.group_html',  group: current_user.own_group.name) %>
    </div>

    <p>

    <%= build_tabs do |tb| %>
      <%= tb.tab(t('.titles.ssh_tab')) do %>

        <%= t('.paragraphs.before_ssh_dp') %> <%= f.radio_button :type, 'UserkeyFlatDirSshDataProvider' %>

        <%= t('.paragraphs.ssh_dp_html') %>

        <fieldset class="groupentry">
          <legend><%= t('.legends.ssh_params') %></legend>

          <div title=<%= t('.titles.remote_host') %>>
            <%= f.label :remote_host, t('.labels.remote_host') %><br>
            <%= f.text_field :remote_host, :size => 40 %>
          </div>

          <p>

          <div title=<%= t('.titles.remote_user') %>>
            <%= f.label :remote_user, t('.labels.remote_user') %><br>
            <%= f.text_field :remote_user, :size => 40 %>
          </div>

          <p>

          <div title=<%= t('.titles.remote_port') %>>
            <%= f.label :remote_port, t('.labels.remote_port') %><br>
            <%= f.text_field :remote_port, :size => 6 %>
          </div>

          <p>

          <div title=<%= t('.titles.remote_dir') %>>
            <%= f.label :remote_dir, t('.labels.remote_dir') %><br>
            <%= f.text_field :remote_dir, :size => 80 %>
          </div>

        </fieldset>

        <p>

        <%= render :partial => 'show_user_key' %>

      <% end %>

      <%= tb.tab(t('.titles.s3_tab')) do %>
        <%= t('.paragraphs.before_ssh_dp') %> <%= f.radio_button :type, 'S3FlatDataProvider' %>

        <%= t('.paragraphs.s3_dp_html') %>

        <fieldset class="groupentry">
          <legend><%= t('.legends.s3_params') %></legend>
          <div title=<%= t('.titles.cloud_storage_endpoint') %>>
            <%= f.label :cloud_storage_endpoint, t('.labels.cloud_storage_endpoint') %><br>
            <%= f.text_field :cloud_storage_endpoint, :size => 80 %>
          </div> <p>

          <div title=<%= t('.titles.cloud_storage_region') %>>
            <%= f.label :cloud_storage_region, t('.labels.cloud_storage_region') %><br>
            <%= f.text_field :cloud_storage_region, :size => 20 %>
          </div> <p>

          <div title=<%= t('.titles.cloud_storage_client_bucket_name') %>>
            <%= f.label :cloud_storage_client_bucket_name, t('.labels.cloud_storage_client_bucket_name') %><br>
            <%= f.text_field :cloud_storage_client_bucket_name, :size => 40 %>
          </div> <p>

          <div title=<%= t('.titles.cloud_storage_client_path_start') %>>
            <%= f.label :cloud_storage_client_path_start, t('.labels.cloud_storage_client_path_start') %><br>
            <%= f.text_field :cloud_storage_client_path_start, :size => 80 %>
          </div> <p>

          <div title=<%= t('.titles.cloud_storage_client_identifier') %>>
            <%= f.label :cloud_storage_client_identifier, t('.labels.cloud_storage_client_identifier') %><br>
            <%= f.text_field :cloud_storage_client_identifier, :size => 40 %>
          </div> <p>

          <div title=<%= t('.titles.cloud_storage_client_token') %>>
            <%= f.label :cloud_storage_client_token, t('.labels.cloud_storage_client_token') %><br>
            <%= f.password_field :cloud_storage_client_token, :size => 80 %>
          </div>
        </fieldset>

      <% end %>

    <% end %>

  </div>

  <p>

  <%= submit_tag t('.submit') %></p>

<% end %>
