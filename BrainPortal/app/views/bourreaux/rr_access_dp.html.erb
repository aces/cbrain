<% title t('.title') %>

<h2><%= t('.headings.main') %></h2>

<% if @rrs.empty? || @dps.empty? %>

<%= t('no_information') %>

<% else %>

<%= t('.paragraphs.rr_access_explanation_html', o_icon: o_icon, not_syncable: html_colorize("(not syncable)", 'purple'), no_access: html_colorize('(no access)', 'red')) %>

<%
# We can refresh all online and accessible bourreaux,
# and the single BrainPortal that corresponds to the current server.
rr_can_refresh = @rrs.select { |b| b.online? && b.has_owner_access?(current_user) && ! (b.is_a?(BrainPortal) && b.id != RemoteResource.current_resource.id)}
%>

<span class="display_cell">

  <table>

    <tr>
      <th colspan="3"><%= t('.headings.servers') %></th>
      <th colspan="<%= @dps.count %>"><%= t('.headings.data_providers') %></th>
    </tr>

    <tr class="no_wrap">
      <th><%= t('.headings.name') %></th>
      <th><%= t('.headings.type') %></th>
      <th>
        <%= t('.headings.last_checked') %>
        <% if rr_can_refresh.size > 1 %>
          (<%= link_to t('.links.refresh_all'), { :refresh => 'all' } %>)
        <% end %>
      </th>
      <% @dps.each do |dp| %>
        <th>
        <%= nil and link_to_data_provider_if_accessible(dp, current_user, :html_options => { :class => dp.online? ? nil : 'error_link' }) %>
        <%= link_to_data_provider_if_accessible(dp, current_user) %>
        <br>
        <%= html_colorize(t('.status.offline'))                if ! dp.online? %>
        <%= html_colorize(t('.status.not_syncable'), 'purple') if dp.not_syncable? %>
        <%= html_colorize(t('.status.read_only'), 'purple')    if dp.read_only? %>
        </th>
      <% end %>
    </tr>

    <% @rrs.each do |rr| %>
      <tr class="no_wrap">
        <th class="left_align">
          <%= nil and link_to_bourreau_if_accessible(rr, current_user, :html_options => { :class => rr.online? ? nil : 'error_link' }) %>
          <%= link_to_bourreau_if_accessible(rr, current_user) %>
          <%= html_colorize(t('.status.offline')) unless rr.online? %>
        </th>
        <td><%= rr.is_a?(Bourreau) ? t('activerecord.models.execution') : t('activerecord.models.portal') %></td>
        <td class="left_align">
          <% last_update = rr.meta[:data_provider_statuses_last_update] %>
          <% if last_update.blank? %>
            (<%= t('unknown') %>)
          <% else %>
            <%= t('ago_time', time: pretty_elapsed(Time.now.to_i - last_update.to_i, :num_components => 2))%>
          <% end %>
          <% if rr_can_refresh.include?(rr) %>
            (<%= link_to t('refresh'), :refresh => rr.id %>)
          <% end %>
        </td>
        <% dp_stats = rr.meta[:data_provider_statuses] %>
        <% @dps.each do |dp| %>
          <td>
            <% if dp_stats.blank? || dp_stats.empty? %>
              <%= html_colorize('?','purple') %>
            <% elsif dp_stats[dp.id] == "alive" %>
              <%= o_icon %>
            <% elsif dp_stats[dp.id] == "down" %>
              <%= times_icon %>
            <% elsif dp_stats[dp.id] == "offline" %>
              <%= html_colorize('?','purple') %>
            <% else %>
              <%= html_colorize('?','purple') %>
            <% end %>
            <%= html_colorize(t('.status.no_access'), 'red') if ! dp.rr_allowed_syncing?(rr) %>
          </td>
        <% end %>
      </tr>
    <% end %>

  </table>

  <%= center_legend(t('.legends.data_provider_status'), [ [o_icon, t('.status.alive')], [times_icon, t('.status.down')], [html_colorize('?','purple'), t('no_information')] ] ) %>

  <% if false && !dps_offline.empty? %>
    <% # commented out %>
    </p>
    <strong><%= t('.data_providers_offline') %></strong>
    <%= array_to_table(dps_offline, :ratio => "1:10", :min_data => 10) do |dp| %>
      <%= link_to_data_provider_if_accessible(dp, current_user) %>
    <% end %>
  <%end%>

  <p>

  <% if !rr_can_refresh.empty? %>
    <%= t('.note_html') %>
  <% end %>

</span>

<% end %>
