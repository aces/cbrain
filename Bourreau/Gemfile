source "https://rubygems.org"

#----------------------
# In the :default group
#----------------------

gem "rails", "~> 8.1.3"

# Network components mostly
gem "net-ssh",       :require => "net/ssh"
gem "net-sftp",      :require => "net/sftp"
gem "x25519"
gem "ed25519"
gem "bcrypt_pbkdf"
# You can comment-out the following two gems if you don't mind not having 'userkey' data providers.
# They are usually the most tricky to compile and integrate into the app.
gem "rbnacl"
gem "rbnacl-libsodium"

# Other utilities
gem "sys-proctable"
gem "mysql2"
gem "pbkdf2-ruby"
gem "json-schema"
gem "aws-sdk-s3"
gem "jwt", ">= 3.0.0"
gem "shannon"
gem "csv"

# ActiveResource channel gems
gem "activeresource", require: "active_resource"
gem "actionpack-xml_parser"
gem "activemodel-serializers-xml"
gem "rexml"

# Bourreau console gems; feel free to comment-out if you never plan to run the console
gem "hirb"
gem "looksee"

# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"
# Use JavaScript with ESM import maps [https://github.com/rails/importmap-rails]
gem "importmap-rails"
# Hotwire's SPA-like page accelerator [https://turbo.hotwired.dev]
gem "turbo-rails"

# Reduces boot times through caching; required in config/boot.rb
# cannot be used on the bourreau side because of symlinks
#gem "bootsnap", require: false

#----------------------
# Test
#----------------------

group :test do
  gem "rspec"
  gem "rspec-core"
  gem "rspec-rails"
  gem "factory_bot",       '6.4.2', :require => false
  gem "factory_bot_rails", '6.4.2', :require => false
  gem "observer"
  gem "rails-controller-testing"
  gem "rspec-mocks"
  gem "rspec-activemodel-mocks"
  gem "rspec-collection_matchers"
  gem "database_cleaner"
end

